[
  {
    "id": 1001,
    "name": "パーンジェネモン",
    "rewardId": 3011,
    "groups": [
      {
        "id": 7000054,
        "srId": 100101,
        "pos": [
          3306,
          5100
        ],
        "dialogues": [
          {
            "id": 72000202,
            "content": "ありゃ、見つかっちゃった。",
            "npc": 820000,
            "next": 72000203
          },
          {
            "id": 72000203,
            "content": "木のそばはあったかいけど、ずっといるわけにはいかないんだよね。",
            "npc": 820000,
            "next": 72000204
          }
        ]
      },
      {
        "id": 7000055,
        "srId": 100101,
        "pos": [
          6161,
          -1757
        ],
        "dialogues": [
          {
            "id": 72000302,
            "content": "誰かが灯りをつけた。",
            "npc": 820000,
            "next": 72000303
          },
          {
            "id": 72000303,
            "content": "ねえ、太陽も誰かが灯した火なのかな？",
            "npc": 820000,
            "next": 72000304
          }
        ]
      },
      {
        "id": 7000058,
        "srId": 100101,
        "pos": [
          3920,
          470
        ],
        "dialogues": [
          {
            "id": 72003902,
            "content": "動く鳥、動かない鳥、そして動かない人もまだここにいる。",
            "npc": 820000,
            "next": 72003903
          },
          {
            "id": 72003903,
            "content": "しかし、動く人はもういない、いつか戻って来るの？",
            "npc": 820000,
            "next": 72003904
          }
        ]
      },
      {
        "id": 7001039,
        "srId": 100102,
        "pos": [
          22429,
          -5823
        ],
        "dialogues": [
          {
            "id": 72000402,
            "content": "そよ風みたいにふわふわ漂えば、風と友だちになれるかな。",
            "npc": 820000,
            "next": 72000403
          },
          {
            "id": 72000403,
            "content": "君も風の友だちになりたい？",
            "npc": 820000,
            "next": 72000404
          }
        ]
      },
      {
        "id": 7001040,
        "srId": 100102,
        "pos": [
          27339,
          5982
        ],
        "dialogues": [
          {
            "id": 72000502,
            "content": "ありがとう、君は草むらみたいな人だね……私、ずっとこの冷たい丸い樽の中に閉じ込められてたんだ。",
            "npc": 820000,
            "next": 72000503
          },
          {
            "id": 72000503,
            "content": "うっ、草むらはなくなっちゃったけど、それでもありがとう、雪のような人間だね。",
            "npc": 820000,
            "next": 72000504
          }
        ]
      }
    ]
  },
  {
    "id": 1011,
    "name": "パーンジェネモン",
    "rewardId": 3011,
    "groups": [
      {
        "id": 7010091,
        "srId": 101101,
        "pos": [
          -6800,
          14207
        ],
        "dialogues": [
          {
            "id": 72001102,
            "content": "この箱、ハローボックスかと思って、ずっと動け動けってお願いしてたんだ。",
            "npc": 820000,
            "next": 72001103
          },
          {
            "id": 72001103,
            "content": "でも違ったのか。もっと早く蹴っ飛ばせばよかったな。",
            "npc": 820000,
            "next": 72001104
          }
        ]
      },
      {
        "id": 7010092,
        "srId": 101101,
        "pos": [
          2622,
          15568
        ],
        "dialogues": [
          {
            "id": 72001202,
            "content": "この木、地面に寝転んでる。ちょっと疲れたみたいだね。",
            "npc": 820000,
            "next": 72001203
          },
          {
            "id": 72001203,
            "content": "だから、地面に落ちた雪も飛び疲れて、休んでるのかな？",
            "npc": 820000,
            "next": 72001204
          }
        ]
      },
      {
        "id": 7010093,
        "srId": 101101,
        "pos": [
          -5764,
          3585
        ],
        "dialogues": [
          {
            "id": 72001302,
            "content": "ここ、あったかい。君も座っていいよ。",
            "npc": 820000,
            "next": 72001303
          },
          {
            "id": 72001303,
            "content": "でも、長居はダメだよ。他にも寒がってる友だちがいるからね。",
            "npc": 820000,
            "next": 72001304
          }
        ]
      },
      {
        "id": 7010094,
        "srId": 101101,
        "pos": [
          -1875,
          2287
        ],
        "dialogues": [
          {
            "id": 72001402,
            "content": "この先は行き止まりか……うーん。",
            "npc": 820000,
            "next": 72001403
          },
          {
            "id": 72001403,
            "content": "いや、ほんとはね、ちょっと一人になりたかったの。君も「独り時間」に付き合ってくれる？",
            "npc": 820000,
            "next": 72001404
          },
          {
            "id": 72001404,
            "content": "……あ、でもそれだと、一人じゃなくなっちゃうか。",
            "npc": 820000,
            "next": 72001405
          }
        ]
      },
      {
        "id": 7010095,
        "srId": 101101,
        "pos": [
          -3618,
          -10058
        ],
        "dialogues": [
          {
            "id": 72001502,
            "content": "ここのおうちはみんな疲れてるみたい。肌にシミがいっぱいだもん。",
            "npc": 820000,
            "next": 72001503
          },
          {
            "id": 72001503,
            "content": "早く元気になれるといいな。",
            "npc": 820000,
            "next": 72001504
          }
        ]
      },
      {
        "id": 7010096,
        "srId": 101101,
        "pos": [
          -2836,
          -1235
        ],
        "dialogues": [
          {
            "id": 72001602,
            "content": "この山、高い！明るい！山頂に立つ私はすごい！",
            "npc": 820000,
            "next": 72001603
          },
          {
            "id": 72001603,
            "content": "え？ここは山じゃないの？どうして？",
            "npc": 820000,
            "next": 72001604
          },
          {
            "id": 72001604,
            "content": "高くてとんがってる場所は山だよ。だからここは山なの！",
            "npc": 820000,
            "next": 72001605
          }
        ]
      },
      {
        "id": 7010100,
        "srId": 101101,
        "pos": [
          -11678,
          279
        ],
        "dialogues": [
          {
            "id": 72001002,
            "content": "壁が言ってたよ。「邪魔したいものは止める」って。",
            "npc": 820000,
            "next": 72001003
          },
          {
            "id": 72001003,
            "content": "けど、通したいものは、城の中に入れてあげるんだとも言ってた。",
            "npc": 820000,
            "next": 72001004
          }
        ]
      },
      {
        "id": 7011065,
        "srId": 101103,
        "pos": [
          -25486,
          -3701
        ],
        "dialogues": [
          {
            "id": 72002202,
            "content": "道路の車と競争してみたいな。どっちが速いかな？",
            "npc": 820000,
            "next": 72002203
          },
          {
            "id": 72002203,
            "content": "でも、車が速すぎると転んじゃうかも。心配だな。",
            "npc": 820000,
            "next": 72002204
          }
        ]
      },
      {
        "id": 7011066,
        "srId": 101103,
        "pos": [
          -31822,
          -12454
        ],
        "dialogues": [
          {
            "id": 72001702,
            "content": "足元の道が見えたら、もう<Default note=\"text:エジュウ\">穢獣</>なんて怖くないよね？",
            "npc": 820000,
            "next": 72001703
          },
          {
            "id": 72001703,
            "content": "ほら、ここも明るくなったよ。",
            "npc": 820000,
            "next": 72001704
          }
        ]
      },
      {
        "id": 7011068,
        "srId": 101103,
        "pos": [
          -29450,
          -9128
        ],
        "dialogues": [
          {
            "id": 72001902,
            "content": "ふふっ、みんな座ってたのに、アレだけ走っていったね。",
            "npc": 820000,
            "next": 72001903
          },
          {
            "id": 72001903,
            "content": "それじゃ、今から「ボックス大会」始めます！",
            "npc": 820000,
            "next": 72001904
          }
        ]
      },
      {
        "id": 7017050,
        "srId": 101103,
        "pos": [
          -12528,
          -1850
        ],
        "dialogues": [
          {
            "id": 72002402,
            "content": "ねえ、神さまみたいにすごい人が、湖ごと持ち上げて、飴みたいに食べちゃうことってあるかな？",
            "npc": 820000,
            "next": 72002403
          },
          {
            "id": 72002403,
            "content": "ダクリ湖ってどんな味だろう。青いから、たぶん空の味だね。",
            "npc": 820000,
            "next": 72002404
          }
        ]
      },
      {
        "id": 7017070,
        "srId": 101103,
        "pos": [
          -33946,
          11686
        ],
        "dialogues": [
          {
            "id": 72002602,
            "content": "ふふっ、おうちを作ってくれてありがとう。",
            "npc": 820000,
            "next": 72002603
          },
          {
            "id": 72002603,
            "content": "いつか君も私と同じくらい大きくなったら、招待するね。お隣さんになろう。",
            "npc": 820000,
            "next": 72002604
          }
        ]
      },
      {
        "id": 7017074,
        "srId": 101103,
        "pos": [
          -45413,
          -7469
        ],
        "dialogues": [
          {
            "id": 72001802,
            "content": "ここにはたくさんの人の気配があったのに、みんないなくなっちゃった。",
            "npc": 820000,
            "next": 72001803
          },
          {
            "id": 72001803,
            "content": "どこへ行ったのかな？",
            "npc": 820000,
            "next": 72001804
          }
        ]
      },
      {
        "id": 7060003,
        "srId": 101108,
        "pos": [
          37795,
          13388
        ],
        "dialogues": [
          {
            "id": 72002702,
            "content": "どこへ行くの？",
            "npc": 820000,
            "next": 72002703
          },
          {
            "id": 72002703,
            "content": "もしガラスのかけらみたいな人に会ったら、友だちになってあげてね。",
            "npc": 820000,
            "next": 72002704
          }
        ]
      }
    ]
  },
  {
    "id": 1013,
    "name": "パーンジェネモン",
    "rewardId": 3011,
    "groups": [
      {
        "id": 7012018,
        "srId": 101301,
        "pos": [
          10360,
          4110
        ],
        "dialogues": [
          {
            "id": 72004002,
            "content": "…消えた灯火の一つ一つは、家に帰れない人なの。",
            "npc": 820000,
            "next": 72004003
          },
          {
            "id": 72004003,
            "content": "つまり…光った灯火の一つ一つは、家に帰れた人ってことね。",
            "npc": 820000,
            "next": 72004004
          }
        ]
      },
      {
        "id": 7018008,
        "srId": 101304,
        "pos": [
          17200,
          34020
        ],
        "dialogues": [
          {
            "id": 72004202,
            "content": "あんな高い場所に積まれて、何の意味があるの？",
            "npc": 820000,
            "next": 72004203
          },
          {
            "id": 72004203,
            "content": "私に譲って。マイホームにするよ。",
            "npc": 820000,
            "next": 72004204
          }
        ]
      }
    ]
  },
  {
    "id": 1017,
    "name": "パーンジェネモン",
    "rewardId": 3011,
    "groups": [
      {
        "id": 7020075,
        "srId": 101701,
        "pos": [
          -6075,
          5070
        ],
        "dialogues": [
          {
            "id": 72004302,
            "content": "ひらひら～わがはいは自由なアヒルである。",
            "npc": 820000,
            "next": 72004303
          },
          {
            "id": 72004303,
            "content": "ひゃっ！？なんでプールの水を抜いたんだよ！",
            "npc": 820000,
            "next": 72004304
          }
        ]
      },
      {
        "id": 7021028,
        "srId": 101701,
        "pos": [
          -22090,
          5830
        ],
        "dialogues": [
          {
            "id": 72004602,
            "content": "ありゃ、見つかっちゃった。うちの秘密基地へようこそ。",
            "npc": 820000,
            "next": 72004603
          },
          {
            "id": 72004603,
            "content": "ツタ、水草、池、そして私。小っちゃい生物圏ではないか。",
            "npc": 820000,
            "next": 72004604
          }
        ]
      },
      {
        "id": 7021030,
        "srId": 101702,
        "pos": [
          -35270,
          -16890
        ],
        "dialogues": [
          {
            "id": 72004502,
            "content": "ドンドン、ドンドンドン！",
            "npc": 820000,
            "next": 72004503
          },
          {
            "id": 72004503,
            "content": "パイプ・オルガンの練習をしてるんだ。",
            "npc": 820000,
            "next": 72004504
          }
        ]
      },
      {
        "id": 7022013,
        "srId": 101703,
        "pos": [
          -11660,
          -5460
        ],
        "dialogues": [
          {
            "id": 72002902,
            "content": "ひー——！！！この宝箱をとらないで。",
            "npc": 820000,
            "next": 72002903
          },
          {
            "id": 72002903,
            "content": "うちの家は悪いネズミたちに奪い取れた。この金で勇敢な子猫ちゃんを雇おうと思ってたんだ。",
            "npc": 820000,
            "next": 72002904
          },
          {
            "id": 72003002,
            "content": "うゎー！ すごい！ちゃちゃっと近くのネズミたちを片付けた。",
            "npc": 820000,
            "next": 72003003
          },
          {
            "id": 72003003,
            "content": "じゃあ、この宝箱はあんたにあげるね。",
            "npc": 820000,
            "next": 72003004
          }
        ]
      }
    ]
  },
  {
    "id": 1021,
    "name": "パーンジェネモン",
    "rewardId": 3011,
    "groups": [
      {
        "id": 7030055,
        "srId": 102101,
        "pos": [
          -4267,
          -47051
        ],
        "dialogues": [
          {
            "id": 72000602,
            "content": "くるくる……くるくる……め、目が回る……",
            "npc": 820000,
            "next": 72000603
          },
          {
            "id": 72000603,
            "content": "これ、すごく危険だね。イコルだらけだし、くるくる回って全然止まらないし……まさか罠だったり？",
            "npc": 820000,
            "next": 72000604
          }
        ]
      },
      {
        "id": 7030071,
        "srId": 102101,
        "pos": [
          -6281,
          -3629
        ],
        "dialogues": [
          {
            "id": 72000702,
            "content": "逃げ惑う群衆に、追う群衆……",
            "npc": 820000,
            "next": 72000703
          },
          {
            "id": 72000703,
            "content": "人間もかくれんぼ好きなのかな？でも、あんまり楽しそうじゃなかったような……",
            "npc": 820000,
            "next": 72000704
          }
        ]
      },
      {
        "id": 7030072,
        "srId": 102101,
        "pos": [
          11421,
          -48647
        ],
        "dialogues": [
          {
            "id": 72003102,
            "content": "何を探してるの？",
            "npc": 820000,
            "next": 72003103
          },
          {
            "id": 72003103,
            "content": "一緒に探してあげる。私を探してるんじゃなければね。",
            "npc": 820000,
            "next": 72003104
          }
        ]
      },
      {
        "id": 7030074,
        "srId": 102101,
        "pos": [
          -2443,
          -42175
        ],
        "dialogues": [
          {
            "id": 72003302,
            "content": "たくさんの人が来て、またたくさんの人が去ったの。",
            "npc": 820000,
            "next": 72003303
          },
          {
            "id": 72003303,
            "content": "においが多すぎて覚えきれないや……君は、みんなのこと覚えてる？",
            "npc": 820000,
            "next": 72003304
          }
        ]
      },
      {
        "id": 7030081,
        "srId": 102101,
        "pos": [
          11012,
          -31063
        ],
        "dialogues": [
          {
            "id": 72000802,
            "content": "兵士が三人動物園へ……二人は日向ぼっこへ……",
            "npc": 820000,
            "next": 72000803
          },
          {
            "id": 72000803,
            "content": "一人だけ無事だった……",
            "npc": 820000,
            "next": 72000804
          }
        ]
      },
      {
        "id": 7031051,
        "srId": 102102,
        "pos": [
          -5805,
          -20124
        ],
        "dialogues": [
          {
            "id": 72003602,
            "content": "ここは、ちょっと外のにおいがする。楽しくて、すごく立派なにおい。",
            "npc": 820000,
            "next": 72003603
          },
          {
            "id": 72003603,
            "content": "他の場所は、ケンカや罵声のにおいばかりだから。",
            "npc": 820000,
            "next": 72003604
          }
        ]
      },
      {
        "id": 7031052,
        "srId": 102102,
        "pos": [
          -17744,
          -8834
        ],
        "dialogues": [
          {
            "id": 72003502,
            "content": "ううっ、痛いよぉ……あそこの蒸気にぶつかっちゃったの。",
            "npc": 820000,
            "next": 72003503
          },
          {
            "id": 72003503,
            "content": "なんて意地悪なの！大っ嫌い！君も友だちになっちゃダメだよ。",
            "npc": 820000,
            "next": 72003504
          }
        ]
      },
      {
        "id": 7031063,
        "srId": 102102,
        "pos": [
          -10601,
          3126
        ],
        "dialogues": [
          {
            "id": 72000902,
            "content": "これで、みんな同じ向きに座ることになるね。",
            "npc": 820000,
            "next": 72000903
          },
          {
            "id": 72000903,
            "content": "足が長すぎてぶつかる心配もないよ。",
            "npc": 820000,
            "next": 72000904
          }
        ]
      }
    ]
  },
  {
    "id": 1060,
    "name": "パーンジェネモン",
    "rewardId": 3011,
    "groups": [
      {
        "id": 7090063,
        "srId": 106001,
        "pos": [
          -10873,
          -4790
        ],
        "dialogues": [
          {
            "id": 72004702,
            "content": "グラスは透明だから、誰も彼のことを気に留めないの。",
            "npc": 820000,
            "next": 72004703
          },
          {
            "id": 72004703,
            "content": "でも、顔が汚れた途端に、初めて誰かが洗ってくれる。",
            "npc": 820000,
            "next": 72004704
          },
          {
            "id": 72004704,
            "content": "じゃあ、私のところに来たのは……どこか汚れてしまったから？",
            "npc": 820000,
            "next": 72004705
          }
        ]
      },
      {
        "id": 7090064,
        "srId": 106001,
        "pos": [
          -3045,
          4865
        ],
        "dialogues": [
          {
            "id": 72004802,
            "content": "めちゃくちゃ……めちゃくちゃだね。",
            "npc": 820000,
            "next": 72004803
          },
          {
            "id": 72004803,
            "content": "ここはめちゃくちゃなの。みんな忙しくて、誰も私に気づかない。だから、私はずっとここにいるんだ。いつになったら気づいてくれるのかなって、ずっと気になってるの。",
            "npc": 820000,
            "next": 72004804
          },
          {
            "id": 72004804,
            "content": "どれくらい経ったのかは、わからないよ。ここからは太陽が見えないから、時間もわからないんだ。",
            "npc": 820000,
            "next": 72004805
          },
          {
            "id": 72004805,
            "content": "でもね、一応数えたの。ここを行ったり来たりした人の数は、もう九千人を超えたよ。",
            "npc": 820000,
            "next": 72004806
          }
        ]
      },
      {
        "id": 7090065,
        "srId": 106001,
        "pos": [
          -7976,
          10
        ],
        "dialogues": [
          {
            "id": 72004902,
            "content": "この青銅の花、おかしいよ！花なのに、おしべがないんだよ。",
            "npc": 820000,
            "next": 72004903
          },
          {
            "id": 72004903,
            "content": "おしべのない花は、心臓のない人間と同じなの。",
            "npc": 820000,
            "next": 72004904
          },
          {
            "id": 72004904,
            "content": "だからね、私がおしべの役をしてあげてるの。はい、どうも。おしべです。よろしく。",
            "npc": 820000,
            "next": 72004905
          }
        ]
      },
      {
        "id": 7090070,
        "srId": 106001,
        "pos": [
          -7982,
          -655
        ],
        "dialogues": [
          {
            "id": 72005402,
            "content": "人間は、集めた花で花冠を編んで、好きな人の頭にのせるんだよね。",
            "npc": 820000,
            "next": 72005403
          },
          {
            "id": 72005403,
            "content": "私はこの場所が好き。だから、ここに丸い印を描いて、足跡で「冠」を編んで、この場所にかぶせてあげるの。",
            "npc": 820000,
            "next": 72005404
          }
        ]
      },
      {
        "id": 7090071,
        "srId": 106001,
        "pos": [
          -6704,
          7194
        ],
        "dialogues": [
          {
            "id": 72005502,
            "content": "ここ、とっても危ないよ！だって、私の背の十何倍も高いんだもん。",
            "npc": 820000,
            "next": 72005503
          },
          {
            "id": 72005503,
            "content": "だからね、木の板の真ん中に、ちゃんと印を描いておいたの。",
            "npc": 820000,
            "next": 72005504
          },
          {
            "id": 72005504,
            "content": "この印に沿って歩けば、落っこちないよ。",
            "npc": 820000,
            "next": 72005505
          }
        ]
      },
      {
        "id": 7090075,
        "srId": 106001,
        "pos": [
          -31907,
          19386
        ],
        "dialogues": [
          {
            "id": 72005902,
            "content": "きれいな森だね！",
            "npc": 820000,
            "next": 72005903
          },
          {
            "id": 72005903,
            "content": "同じママから生まれたのかな？だって、みんな見た目が同じだもん。",
            "npc": 820000,
            "next": 72005904
          },
          {
            "id": 72005904,
            "content": "えっ、人間が作ったの？じゃあ、人間は鉄骨でも産めるの？初めて聞いたよ。本当？嘘じゃないよね？",
            "npc": 820000,
            "next": 72005905
          }
        ]
      }
    ]
  },
  {
    "id": 1063,
    "name": "パーンジェネモン",
    "rewardId": 3011,
    "groups": [
      {
        "id": 7091038,
        "srId": 106301,
        "pos": [
          -14669,
          8847
        ],
        "dialogues": [
          {
            "id": 72005002,
            "content": "目が覚めたら、景色が変わってた。まるで、汽車に乗ってきたみたい。",
            "npc": 820000,
            "next": 72005003
          },
          {
            "id": 72005003,
            "content": "ありがとう、汽車の運転士さん。でもこれ、木でできた車だから……汽車じゃなくて、「木車」かも？",
            "npc": 820000,
            "next": 72005004
          }
        ]
      },
      {
        "id": 7091039,
        "srId": 106301,
        "pos": [
          -9064,
          17552
        ],
        "dialogues": [
          {
            "id": 72005102,
            "content": "人間はみんな、自分の部屋を持ってるんだよね。",
            "npc": 820000,
            "next": 72005103
          },
          {
            "id": 72005103,
            "content": "私も、自分の部屋がほしい。つまり……私の部屋はここだ！",
            "npc": 820000,
            "next": 72005104
          },
          {
            "id": 72005104,
            "content": "ようこそ〜、私のお部屋へ。今から家具をそろえてあげるね。",
            "npc": 820000,
            "next": 72005105
          }
        ]
      },
      {
        "id": 7091040,
        "srId": 106301,
        "pos": [
          -12266,
          15492
        ],
        "dialogues": [
          {
            "id": 72005202,
            "content": "すべり台っていいよね！これは最高のすべり台だよ！",
            "npc": 820000,
            "next": 72005203
          },
          {
            "id": 72005203,
            "content": "私のすべり台は、いつも誰かに壊されちゃうけど……大丈夫。",
            "npc": 820000,
            "next": 72005204
          },
          {
            "id": 72005204,
            "content": "だって私、平たい箱の上でもすべれるんだ。",
            "npc": 820000,
            "next": 72005205
          }
        ]
      },
      {
        "id": 7091041,
        "srId": 106301,
        "pos": [
          -19590,
          11386
        ],
        "dialogues": [
          {
            "id": 72005302,
            "content": "ここの箱、みんな見た目が同じだね。",
            "npc": 820000,
            "next": 72005303
          },
          {
            "id": 72005303,
            "content": "どうやって、兄と弟、姉と妹を見分けるの？",
            "npc": 820000,
            "next": 72005304
          },
          {
            "id": 72005304,
            "content": "見分けなくてもいい？だめだよ。家族がいないと、きっと寂しくなっちゃうもん。",
            "npc": 820000,
            "next": 72005305
          }
        ]
      },
      {
        "id": 7091042,
        "srId": 106301,
        "pos": [
          -12930,
          368
        ],
        "dialogues": [
          {
            "id": 72005602,
            "content": "警備員さんはパトロール中。",
            "npc": 820000,
            "next": 72005603
          },
          {
            "id": 72005603,
            "content": "でも、警備員さんは後ろが見えないの。",
            "npc": 820000,
            "next": 72005604
          },
          {
            "id": 72005604,
            "content": "だから私もパトロール中。警備員さんとは、反対のほうを見てるの。",
            "npc": 820000,
            "next": 72005605
          },
          {
            "id": 72005605,
            "content": "これで悪い人は近づけないよね。完璧だ！",
            "npc": 820000,
            "next": 72005606
          }
        ]
      },
      {
        "id": 7091043,
        "srId": 106301,
        "pos": [
          -13386,
          7056
        ],
        "dialogues": [
          {
            "id": 72005702,
            "content": "決まった線路に沿って走る車は、列車。",
            "npc": 820000,
            "next": 72005703
          },
          {
            "id": 72005703,
            "content": "決まった線路に沿って走るパーンジェネモンは……列車ジェネモン！",
            "npc": 820000,
            "next": 72005704
          },
          {
            "id": 72005704,
            "content": "この名前はどう？私は気に入ったよ！",
            "npc": 820000,
            "next": 72005705
          }
        ]
      },
      {
        "id": 7091044,
        "srId": 106301,
        "pos": [
          -16072,
          13405
        ],
        "dialogues": [
          {
            "id": 72005802,
            "content": "列車って、おばかさんなんだよ。線路がないと、橋も渡れないんだもん。",
            "npc": 820000,
            "next": 72005803
          },
          {
            "id": 72005803,
            "content": "だから、私が教えてあげるの。こうやって、ぴょんって飛べば渡れるんだよ。",
            "npc": 820000,
            "next": 72005804
          },
          {
            "id": 72005804,
            "content": "飛べないのは、列車が悪いんだよ！いつも走ってるんだから、体は軽いはずなのに。",
            "npc": 820000,
            "next": 72005805
          },
          {
            "id": 72005805,
            "content": "いったい、どういうこと？",
            "npc": 820000,
            "next": 72005806
          }
        ]
      }
    ]
  },
