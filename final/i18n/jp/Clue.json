[
  {
    "type": "Ex02_Core",
    "name": "要点",
    "priority": 55,
    "pages": [
      {
        "id": "Ex02_MainStory_1001",
        "name": "フルヴィス",
        "clues": [
          {
            "id": 100101,
            "name": "フルヴィスの行方",
            "contents": [
              {
                "id": 10010101,
                "text": "フルヴィスはすでにフレグサン領に到着しているが、現在の動向は不明だ。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11100001
                }
              },
              {
                "id": 10010102,
                "text": "「力」バーナードの話によると、ここ5日間、アルカノ山でフルヴィスらしき人物は目撃されていない。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11100241
                }
              },
              {
                "id": 10010103,
                "text": "「女教皇」エイダも私以外の帝国軍の者を見たことがないという。どうやらアルカノの町の住民は、軍人フルヴィスという人物をほとんど知らないようだ。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11101617
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0005",
            "pic2": "T_StringBoard_Main_0005",
            "type": 1
          },
          {
            "id": 100102,
            "name": "フルヴィスの行動",
            "contents": [
              {
                "id": 10010201,
                "text": "フルヴィスはフォルスの生死を確認できなかったため、密偵を放ってその行方を追わせ、口封じを図った。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11105822
                }
              },
              {
                "id": 10010202,
                "text": "フルヴィスの部下は二手に分かれてアルカノ山付近に駐屯しており、山の奥深くまでは入っていない。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11111019
                }
              },
              {
                "id": 10010203,
                "text": "フルヴィスは記憶を失ってなどおらず、ずっと「愚者」ジョイを装い、密かに私と楽園の町との対立を煽っていた。双方が共倒れになった隙に、触媒を奪うためだ。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11120338
                }
              },
              {
                "id": 10010204,
                "text": "私はフルヴィスの偽装を見抜き、早い段階で彼の通信機をすり替えて、その陰謀を打ち砕いた。完全に逆転の望みがないと悟ったフルヴィスは、自らの戦闘車両を爆破してアルカノの町を火の海に変え、私たちと刺し違えようとした。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11120622
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0004",
            "pic2": "T_StringBoard_Main_0006",
            "type": 1
          }
        ],
        "unlock": 11020101
      },
      {
        "id": "Ex02_MainStory_1002",
        "name": "触媒",
        "clues": [
          {
            "id": 100201,
            "name": "触媒",
            "contents": [
              {
                "id": 10020101,
                "text": "触媒を使えば、一つの原型を設計図として、その複製を次々に作り出せる。触媒はおそらく、楽園の町の主である「ウサギママ」が所持している。ただし、どのような形で存在するのかは誰も知らない。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11100001
                }
              },
              {
                "id": 10020102,
                "text": "触媒は、人間を含む既存のものを複製できる。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11120305
                }
              },
              {
                "id": 10020103,
                "text": "「第2イノバンス」計画に必要な触媒は、エイダの血筋に受け継がれた「複製」能力である。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11120334
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0004",
            "pic2": "T_StringBoard_Main_0007",
            "type": 1
          }
        ],
        "unlock": 11020101
      },
      {
        "id": "Ex02_MainStory_1003",
        "name": "アルカノ山",
        "clues": [
          {
            "id": 100301,
            "name": "アルカノの町の暮らし",
            "contents": [
              {
                "id": 10030101,
                "text": "アルカノの町の住民は、それぞれ世界に一つだけの名札を持っている。エイダの「女教皇」や私の「戦車」など、全部で21個ある。これらの名札には、持ち主全員が楽園の家族であるという意味が込められている。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11101619
                }
              },
              {
                "id": 10030102,
                "text": "楽園の町には、全員が必ず守らなければならないルールがある。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11106524
                }
              },
              {
                "id": 10030103,
                "text": "楽園の町では皆がとても仲良く暮らしている。意見が食い違っても、ただ言い争ったり暴力に訴えたりせず、ゲームを通じて解決する。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11108404
                }
              },
              {
                "id": 10030104,
                "text": "ソラもカロンも、楽園の町では平等に、幸せに暮らしている。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11111057
                }
              },
              {
                "id": 10030105,
                "text": "楽園の町には「くるみ割り人形」という玩具があり、精巧な作りで、見た目も愛らしい。町の人々の日常を助ける便利な存在で、モルガナによれば、私も幼い頃に彼女から作り方を教わったらしい。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11106804
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0004",
            "pic2": "T_StringBoard_Main_0008",
            "type": 1
          },
          {
            "id": 100302,
            "name": "楽園巡遊",
            "contents": [
              {
                "id": 10030201,
                "text": "楽園の町では毎月、「楽園巡遊」という特別な祭りが開かれ、その夜にはウサギママがやって来る。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11100902
                }
              },
              {
                "id": 10030202,
                "text": "楽園巡遊の最中には、ある「ゲーム」が行われる。そのゲームで最も多く票を集めた参加者は、排除される。\n 楽園巡遊の本質は、ウサギママが楽園の住民たちに課す忠誠心の試験である。楽園のルールに背いた者は処刑される。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11115049
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0004",
            "pic2": "T_StringBoard_Main_0009",
            "type": 1
          },
          {
            "id": 100303,
            "name": "山中の異変",
            "contents": [
              {
                "id": 10030301,
                "text": "なぜか、山に入ってから突然めまいを覚えることが多い。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11100406
                }
              },
              {
                "id": 10030302,
                "text": "アルカノの元の住民のほとんどは戦争で命を落としている。現在楽園に暮らす住民たちは、町長とウサギママに脅され、かつての町人たちの役割を演じさせられているよそ者である。掟を破った者、あるいは与えられた役割を演じきれなかった者は、町長によって処刑され、「うつつ池」の底にある墓地へと葬られる。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11117210
                }
              },
              {
                "id": 10030303,
                "text": "アルカノ山の水には、チェーザレが錬金院の薬剤を混ぜていた。この薬剤は本来、兵士を落ち着かせ、冷静さを保たせるためのものだ。しかし過剰に摂取すると精神に影響を及ぼし、命令に従うことしかできなくなる。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11117225
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0004",
            "pic2": "T_StringBoard_Main_0010",
            "type": 1
          },
          {
            "id": 100304,
            "name": "アルカノの町のルール・その1",
            "contents": [
              {
                "id": 10030401,
                "text": "第一条 アルカノ山は私たちの楽園。私たちは皆、ウサギママの白ウサギである。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11114213
                }
              },
              {
                "id": 10030402,
                "text": "第二条 白ウサギは皆、互いに愛し合い、白ウサギへの暴力を禁ずる。対立が生じた場合は、ゲームで解決すること。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11114213
                }
              },
              {
                "id": 10030403,
                "text": "第三条 ウサギにはさまざまな色がある。白いウサギは私たちの友達、赤いウサギは危険な存在である。赤いウサギを見つけたら、ただちに町長へ報告すること。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11114213
                }
              },
              {
                "id": 10030404,
                "text": "第四条 <up text=\"ワンダーランド・パレード\">楽園巡遊</>はアルカノ町の大切なお祭りである。楽園巡遊の祝いでは、必ず一度ゲームを行わなければならない。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11114213
                }
              },
              {
                "id": 10030405,
                "text": "第五条 アルカノ山の玩具は、私たちの友好的な仲間である。彼らの護衛と助けを受けてもよい。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11114213
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0004",
            "pic2": "T_StringBoard_Main_0011",
            "type": 1
          },
          {
            "id": 100305,
            "name": "アルカノの町のルール・その2",
            "contents": [
              {
                "id": 10030406,
                "text": "第六条 すべての白ウサギは、自分たちの名札を心に刻むこと。名札は私たちの本質を示すものである。その本質に背いてはならない。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11114213
                }
              },
              {
                "id": 10030407,
                "text": "第七条 空に浮かぶ鉄の巨人は、楽園の敵である。鉄の巨人を見た場合、手にしているものをすべて置き、直ちにうつつ池へ向かうこと。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11114213
                }
              },
              {
                "id": 10030408,
                "text": "第八条 ルールを破った場合、うつつ池は私たちが心の静けさを取り戻す助けとなる。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11114213
                }
              },
              {
                "id": 10030409,
                "text": "第九条 鉄の巨人が現れていない場合、町長の許可なくうつつ池へ近づくことを禁ずる。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11114213
                }
              },
              {
                "id": 10030410,
                "text": "第十条 外界の騒がしさによって私たちの暮らしが壊されぬよう、いかなる白ウサギも、みだりに楽園を離れてはならない。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11114213
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0004",
            "pic2": "T_StringBoard_Main_0012",
            "type": 1
          }
        ],
        "unlock": 11020101
      }
    ]
  },
  {
    "type": "Ex02_Region",
    "name": "地域",
    "priority": 45,
    "pages": [
      {
        "id": "Ex02_Region_1101",
        "name": "アルカノの町の廃墟",
        "clues": [
          {
            "id": 110101,
            "name": "概要",
            "contents": [
              {
                "id": 11010101,
                "text": "4年前に戦争で破壊されたアルカノの町は人影もまばらで、かろうじて稼働する施設がいくつか残っているだけだ。そこは、私とエイダがかつて暮らしていた故郷でもある。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11101102
                }
              },
              {
                "id": 11010102,
                "text": "4年前、前線への奇襲に向かった帝国軍の飛空艇部隊は、攻撃に失敗した後、アルカノ山へ緊急着陸した。生き残った兵士たちはその場を堅守し、エリュシオン礼賛会の地上部隊をできる限り足止めするよう命じられた。最終的に帝国軍は大規模な航空火力を投入し、アルカノ山で礼賛会の進撃を食い止めることに成功したが、アルカノの町もこの爆撃によって完全に破壊された。",
                "trigger": {
                  "type": "Resource",
                  "id": 2000128
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0013",
            "pic2": "T_StringBoard_Main_0014",
            "type": 2
          }
        ],
        "unlock": 11020102
      },
      {
        "id": "Ex02_Region_1102",
        "name": "アルカノ山の裂け目",
        "clues": [
          {
            "id": 110201,
            "name": "概要",
            "contents": [
              {
                "id": 11020101,
                "text": "爆撃を受けた礼賛会の兵士たちはアルカノ山の裂け目へ退却した。帝国軍の追撃を遅らせるため、撤退しながら道中に大量の地雷を敷設した。",
                "trigger": {
                  "type": "Resource",
                  "id": 2000129
                }
              },
              {
                "id": 11020102,
                "text": "4年前、帝国軍の榴弾に含まれていた有毒物質が周辺の土壌と小川に染み込み、目の前にある異様な色の湖を形成した。この水は極めて危険で、穢獣でさえ生息できない。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11114002
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0015",
            "pic2": "T_StringBoard_Main_0016",
            "type": 2
          }
        ],
        "unlock": 11020104
      },
      {
        "id": "Ex02_Region_1103",
        "name": "アルカノの町",
        "clues": [
          {
            "id": 110301,
            "name": "帝国軍の記録",
            "contents": [
              {
                "id": 11030101,
                "text": "アルカノの町はアルカノ山の山間の台地にあり、山と同じ名を持つ。当初は小さな町だったが、町内の遊園地が完成すると大勢の観光客が押し寄せ、町は拡張されてにぎやかな観光都市となった。\n",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11100001
                }
              },
              {
                "id": 11030102,
                "text": "四年前の戦争では、アルカノの町は一時、辺境軍団の数ある補給拠点の一つとなった。しかし戦火が激化するにつれ、かつては安全だった多くの町も戦渦に巻き込まれ、アルカノの町もそのようにして戦争によって壊滅した町の一つとなった。\n戦争生存者の記録によれば、アルカノの町の住民の大部分は当時の戦争で命を落とし、アルカノ町はこうして歴史の彼方へと消えたのである。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11100001
                }
              },
              {
                "id": 11030103,
                "text": "四年前の戦争は、アルカノ山に取り返しのつかない影響を残した。山間のアルカノの町は破壊され、住民は全員死亡、広範囲にわたって人間の居住に適さない地域となった。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11100001
                }
              },
              {
                "id": 11030104,
                "text": "さらに、礼賛会の兵士が撤退する際、帝国軍の追撃速度を遅らせるため、山中に大量の地雷を敷設した。これらの要因が重なり、帝国はこの数年、アルカノ山およびアルカノ町の奪還と再建に着手できずにいた。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11100001
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0004",
            "pic2": "T_StringBoard_Main_0017",
            "type": 2
          },
          {
            "id": 110302,
            "name": "楽園の町",
            "contents": [
              {
                "id": 11030201,
                "text": "ウサギママは、戦火によって荒れ果てた廃墟の中で、たった一人でアルカノの町を再建し、その地を「楽園」と名づけた。今では生き残った人々が、この町で穏やかで満ち足りた暮らしを送っている。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11101610
                }
              },
              {
                "id": 11030202,
                "text": "通常、跳ね橋は楽園の町で唯一の出入口であり、町の内側で誰かがスイッチを引き続けなければ作動しない。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11110403
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0018",
            "pic2": "T_StringBoard_Main_0019",
            "type": 2
          },
          {
            "id": 110303,
            "name": "倉庫",
            "contents": [
              {
                "id": 11030301,
                "text": "楽園の町の倉庫には、さまざまな食材、玩具、衣服、装飾品が整然と並べられている。どれも形が完全に同じで、破損箇所まで一致しており、触媒によって作られた可能性が高い。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11108813
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0019",
            "pic2": "T_StringBoard_Main_0021",
            "type": 2
          },
          {
            "id": 110304,
            "name": "うつつ池",
            "contents": [
              {
                "id": 11030401,
                "text": "フォルスは一人でうつつ池を調査した。そこには誰もおらず、むしろ牢獄のように見える。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11111047
                }
              },
              {
                "id": 11030402,
                "text": "うつつ池の下には墓地があり、アルカノの町の住民全員が埋葬されている。その中には「私」――ヴィクターの墓もある。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11117201
                }
              },
              {
                "id": 11030403,
                "text": "墓穴で見つけた開かない箱は、すべてが片づいてから改めて調べに来よう。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11116801
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0022",
            "pic2": "T_StringBoard_Main_0023",
            "type": 2
          },
          {
            "id": 110305,
            "name": "山林での発見",
            "contents": [
              {
                "id": 11030501,
                "text": "4年前、帝国軍の飛空艇がここへ不時着した。二人の生存者は本隊と合流する前に礼賛会の先遣部隊と遭遇し、森の中で銃撃戦になった。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11112301
                }
              },
              {
                "id": 11030502,
                "text": "兵士だった生存者の一人の墓碑を発見した。もう一人の、将校らしき生存者は行方不明だ。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11112701
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0069",
            "pic2": "T_StringBoard_Main_0025",
            "type": 2
          }
        ],
        "unlock": 11020101
      }
    ]
  },
  {
    "type": "Ex02_Character",
    "name": "人物",
    "priority": 30,
    "pages": [
      {
        "id": "Ex02_Character_1201",
        "name": "フォルス",
        "clues": [
          {
            "id": 120101,
            "name": "フォルス",
            "contents": [
              {
                "id": 12010101,
                "text": "フルヴィスはロンザ要塞の爆発を利用してフォルスを口封じしようとしたが、彼女は爆発を生き延び、アルカノ山まで追ってきた。残念ながら、彼女の録音機器は爆発で壊れており、フルヴィスを失脚させる証拠がまた一つ失われた。少なくとも、人証であるフォルスだけは連れて帰らなければならない。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11102821
                }
              },
              {
                "id": 12010102,
                "text": "フォルスはロンザ要塞の爆発から生き延びた後、フルヴィスを殺して復讐を果たすことだけを考えていた。まだ癒えていない傷を見るに、アルカノ山へ来るまでの間に、フルヴィスの密偵たちと何度も血なまぐさい戦いを繰り広げたようだ。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11105822
                }
              },
              {
                "id": 12010103,
                "text": "ロンザ要塞の真相が記録された音声ファイルを探すため、フォルスは一人で火の海へ足を踏み入れ、そのまま行方不明になった。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11121012
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0004",
            "pic2": "T_StringBoard_Main_0026",
            "type": 3
          }
        ],
        "unlock": 11020104
      },
      {
        "id": "Ex02_Character_1202",
        "name": "アルカノの町の住民・その1",
        "clues": [
          {
            "id": 120204,
            "name": "「審判」ウサギママ",
            "contents": [
              {
                "id": 12020401,
                "text": "「ウサギママ」は謎めいた強大な「骸」であり、「第2イノバンス」計画の鍵となる「触媒」の所有者でもある。アヴァール教官の情報によれば、何が起きようとも、たとえ触媒もろとも敵と刺し違えることになっても、彼女が触媒を渡すことはない。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11100001
                }
              },
              {
                "id": 12020402,
                "text": "ウサギママはアルカノの町で非常に高い地位にあり、町の再建を取り仕切った技師でもあるらしい。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11101610
                }
              },
              {
                "id": 12020403,
                "text": "ウサギママは4年前の戦争におけるアルカノの町唯一の生存者で、本物のエイダでもある。彼女は希少な複製魔法を持っている。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11120305
                }
              },
              {
                "id": 12020404,
                "text": "エイダは最後の力で、火の海と化しつつあるアルカノの町の廃墟から私たちを脱出させた。その後、町長に背負われて炎の中へ入り、火の中に消えた。今も行方は分かっていない。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11120823
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0031",
            "pic2": "T_StringBoard_Main_0032",
            "type": 3
          },
          {
            "id": 120201,
            "name": "「力」バーナード",
            "contents": [
              {
                "id": 12020101,
                "text": "アルカノの町の猟師。情熱的で親切、山中でよく活動している。彼は一昨日、見知らぬ女性の姿が森の中を横切るのを目撃した。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11100241
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0004",
            "pic2": "T_StringBoard_Main_0027",
            "type": 3
          },
          {
            "id": 120202,
            "name": "「女教皇」エイダ",
            "contents": [
              {
                "id": 12020201,
                "text": "アルカノの町の住民の一人。素直な性格に見えるが、少々突拍子もないことを考える。本人によれば、ヴィクターの幼なじみだという。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11100414
                }
              },
              {
                "id": 12020202,
                "text": "フォルスは、エイダが冷淡にほかの住民を殺すところを目撃した。エイダは見た目ほど純真無垢ではないようだ。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11105834
                }
              },
              {
                "id": 12020203,
                "text": "エイダはゲームと、ゲームの中で演じるさまざまな役柄が好きだ。彼女は一生この山奥から出られないと言っていた。なぜだろう？",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11103808
                }
              },
              {
                "id": 12020204,
                "text": "エイダは、ウサギママにとって特別な存在だ。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11115516
                }
              },
              {
                "id": 12020205,
                "text": "ウサギママの裁判の最中、エイダはウサギママから与えられた「エイダ」という名を捨て、自ら新たな名前を選んだ。それが「イブ」である。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11118623
                }
              },
              {
                "id": 12020206,
                "text": "実は「ウサギママ」、つまり本物のエイダが、自分自身を原型として複製した存在である。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11120305
                }
              },
              {
                "id": 12020207,
                "text": "アルカノ山を脱出した後、イブは一人旅に出た。今、彼女はついに自分の目で外の世界を見ることができる。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11121420
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0028",
            "pic2": "T_StringBoard_Main_0029",
            "type": 3
          },
          {
            "id": 120203,
            "name": "「戦車」ヴィクター",
            "contents": [
              {
                "id": 12020301,
                "text": "ここの住民は皆、私を「戦車」ヴィクターと呼ぶ。4年前に故郷のアルカノの町を離れ、帝国軍に加わったという。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11100225
                }
              },
              {
                "id": 12020302,
                "text": "幼い頃、ヴィクターはエイダと一緒に虫を捕まえたり、アルカノの町で遊んだり、バーナードと狩りに出たりしていた。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11106802
                }
              },
              {
                "id": 12020303,
                "text": "町の住民たちは、今の私の顔をはっきり覚えていないようだ。帝国軍に入ってから、そんなに見た目が変わったのだろうか？",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11106537
                }
              },
              {
                "id": 12020304,
                "text": "朦朧とする意識の中で、断片的な記憶が見えた。ヴィクターとして町の住民たちと暮らしていた記憶らしい。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11108302
                }
              },
              {
                "id": 12020305,
                "text": "私はヴィクターではない。すべてはアルカノの町の住民たちの嘘だった。本物のヴィクターはアルカノの町の住民で、4年前の戦争ですでに亡くなっている。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11117210
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0004",
            "pic2": "T_StringBoard_Main_0030",
            "type": 3
          },
          {
            "id": 120205,
            "name": "「皇帝」チェーザレ",
            "contents": [
              {
                "id": 12020501,
                "text": "アルカノの町の町長。彼がエイダに渡した謎の薬剤は、私とフォルスの傷を和らげた。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11105405
                }
              },
              {
                "id": 12020502,
                "text": "チェーザレがエイダに渡した謎の薬剤は、4年前に錬金院が上級将校へ支給した興奮剤だった。チェーザレと帝国軍にはどんな関係があるのだろう？",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11115524
                }
              },
              {
                "id": 12020503,
                "text": "チェーザレこそ、当時不時着した飛空艇のもう一人の将校の生存者だった。彼はアルカノの町の廃墟で瀕死のエイダを救った。そしてエイダは、彼にとって戦争の中で得た唯一の救いとなった。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11123840
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0004",
            "pic2": "T_StringBoard_Main_0033",
            "type": 3
          },
          {
            "id": 120206,
            "name": "「星」ステラ",
            "contents": [
              {
                "id": 12020601,
                "text": "臆病で、泣き虫で、心配性な少女。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11106506
                }
              },
              {
                "id": 12020602,
                "text": "ステラは心の中に、自分を怯えさせる秘密を隠している。それも彼女がよく泣く理由の一つだ。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11108949
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0004",
            "pic2": "T_StringBoard_Main_0034",
            "type": 3
          },
          {
            "id": 120207,
            "name": "「太陽」エリオ",
            "contents": [
              {
                "id": 12020701,
                "text": "元気な少年。私の帝国軍での暮らしに興味津々だ。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11106506
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0004",
            "pic2": "T_StringBoard_Main_0035",
            "type": 3
          }
        ],
        "unlock": 11020101
      },
      {
        "id": "Ex02_Character_1203",
        "name": "アルカノの町の住民・その2",
        "clues": [
          {
            "id": 120208,
            "name": "「月」セレナ",
            "contents": [
              {
                "id": 12020801,
                "text": "素直で物分かりのいい少女。いつもステラやエリオと一緒に行動している。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11106506
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0004",
            "pic2": "T_StringBoard_Main_0036",
            "type": 3
          },
          {
            "id": 120209,
            "name": "「女帝」テレサ",
            "contents": [
              {
                "id": 12020901,
                "text": "優しい婦人。家事全般が得意で、料理の腕も抜群だ。自宅の庭で野菜を育てるだけでなく、家でハトも飼っている。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11106506
                }
              },
              {
                "id": 12020902,
                "text": "テレサは「楽園巡遊」のゲームで脱落した後、自ら命を絶った。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11116601
                }
              },
              {
                "id": 12020903,
                "text": "テレサは元々主婦で、行方不明になった夫フリードを追ってアルカノ山へ来た。彼女は楽園の町での暮らしにとうに耐えられなくなっており、ついに最近、飼っているハトの脚に救援の手紙を結び付け、外へ助けを求めようと決意した。しかしハトは山の猛禽に捕食され、最後まで手紙が届くことはなかった。",
                "trigger": {
                  "type": "Resource",
                  "id": 2000134
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0004",
            "pic2": "T_StringBoard_Main_0037",
            "type": 3
          },
          {
            "id": 120210,
            "name": "「悪魔」アモン",
            "contents": [
              {
                "id": 12021001,
                "text": "厳しい老人。口調は荒いが、言葉の端々に他人への気遣いがにじんでいる。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11106506
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0004",
            "pic2": "T_StringBoard_Main_0038",
            "type": 3
          },
          {
            "id": 120211,
            "name": "「恋人」ヴィーナ",
            "contents": [
              {
                "id": 12021101,
                "text": "妖艶な少女。私とフォルスの関係に興味を持っている。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11106506
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0004",
            "pic2": "T_StringBoard_Main_0039",
            "type": 3
          },
          {
            "id": 120212,
            "name": "「魔術師」モルガナ",
            "contents": [
              {
                "id": 12021201,
                "text": "手芸と機械が得意な若い女性。手先が器用だ。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11106506
                }
              },
              {
                "id": 12021202,
                "text": "「楽園巡遊」のゲームでテレサを疑い、彼女を脱落させた。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11115003
                }
              },
              {
                "id": 12021203,
                "text": "本名はキャサリン。民俗学者ウッドヴィルの教え子である。彼女はとっくに薬剤の影響から抜けていたが、最も確実で安全な脱出の機会を得るため、懸命に「魔術師」モルガナを演じ続けていた。以前、疑いをテレサへ向けたのも、先生を守るためだったのだろう。自分と先生の安全のためなら、冷酷とも言えるほど冷静でいられる。",
                "trigger": {
                  "type": "Resource",
                  "id": 2000135
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0004",
            "pic2": "T_StringBoard_Main_0040",
            "type": 3
          },
          {
            "id": 120213,
            "name": "「教皇」サンクトゥス",
            "contents": [
              {
                "id": 12021301,
                "text": "信心深い中年男性。ウサギママを神として崇めている。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11106506
                }
              },
              {
                "id": 12021302,
                "text": "サンクトゥスは外の世界でソラの民からひどい迫害を受け、ついに楽園で唯一の居場所を得た。そのためウサギママに絶対の忠誠を誓い、彼女のためなら命さえ捧げようとしている。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11118913
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0004",
            "pic2": "T_StringBoard_Main_0041",
            "type": 3
          },
          {
            "id": 120214,
            "name": "「運命の輪」カルマ",
            "contents": [
              {
                "id": 12021401,
                "text": "神がかった雰囲気の青年。いつも理解できないことばかり口にしている。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11106506
                }
              },
              {
                "id": 12021402,
                "text": "カルマは元々、何も持たない浮浪者だった。彼自身も「運命の輪」として、奥深く謎めいた話し方を続けることにとうにうんざりしていた。ウサギママの支配から逃れた後、抑えていた感情を一気に爆発させた。",
                "trigger": {
                  "type": "Resource",
                  "id": 2000138
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0004",
            "pic2": "T_StringBoard_Main_0042",
            "type": 3
          }
        ],
        "unlock": 11020302
      },
      {
        "id": "Ex02_Character_1204",
        "name": "アルカノの町の住民・その3",
        "clues": [
          {
            "id": 120215,
            "name": "「正義」ユストゥス",
            "contents": [
              {
                "id": 12021501,
                "text": "厳格な中年男性。楽園の町のルールを何度も強調する。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11106506
                }
              },
              {
                "id": 12021502,
                "text": "ユストゥスはかつて雇われの殺し屋だった。外の世界で居場所を失い、最後に楽園で新たな人生を得た。何があろうと、彼がウサギママを裏切ることはない。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11118917
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0004",
            "pic2": "T_StringBoard_Main_0043",
            "type": 3
          },
          {
            "id": 120216,
            "name": "「吊された男」アイザック",
            "contents": [
              {
                "id": 12021601,
                "text": "気さくな老人。アルカノの町で特に何かを担当しているわけではなく、いつものんびりしている。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11106506
                }
              },
              {
                "id": 12021602,
                "text": "本名はウッドヴィル。イーザーの民俗学者である。教え子のキャサリンを連れてアルカノ山へ調査に来たが、ウサギママに囚われ、楽園の町で「吊された男」を演じるしかなかった。",
                "trigger": {
                  "type": "Resource",
                  "id": 2000135
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0004",
            "pic2": "T_StringBoard_Main_0044",
            "type": 3
          },
          {
            "id": 120217,
            "name": "「塔」アンビティオ",
            "contents": [
              {
                "id": 12021701,
                "text": "少し間の抜けた青年に見える。服にはフォーセイクン同盟の印が付いており、同盟とどんな関係があるのかは不明だ。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11106506
                }
              },
              {
                "id": 12021702,
                "text": "取り調べの結果、帝国軍は彼が確かにフォーセイクン同盟の一員だと暫定的に判断した。ただし、チェーザレの薬によって記憶を完全に失っている。",
                "trigger": {
                  "type": "Resource",
                  "id": 2000137
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0004",
            "pic2": "T_StringBoard_Main_0045",
            "type": 3
          },
          {
            "id": 120218,
            "name": "「隠者」タキタ",
            "contents": [
              {
                "id": 12021801,
                "text": "無口な老女。意思の疎通が難しい。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11106506
                }
              },
              {
                "id": 12021802,
                "text": "タキタの本名はジェニー。数年前、他人と意地を張って賭けをした末、アルカノ山へやって来た。",
                "trigger": {
                  "type": "Resource",
                  "id": 2000139
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0004",
            "pic2": "T_StringBoard_Main_0046",
            "type": 3
          },
          {
            "id": 120219,
            "name": "「死神」フィニス",
            "contents": [
              {
                "id": 12021901,
                "text": "この名前を聞いただけで、アルカノの町で本人を見たことはない。おそらく彼が、フォルスの目の前でエイダに冷酷に殺された住民なのだろう。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11121420
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0004",
            "pic2": "T_StringBoard_Main_0047",
            "type": 3
          },
          {
            "id": 120220,
            "name": "「節制」メンスラ",
            "contents": [
              {
                "id": 12022001,
                "text": "几帳面な中年女性。やや強迫的な行動が見られる。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11106506
                }
              },
              {
                "id": 12022002,
                "text": "取り調べの結果、彼女はチェーザレの薬の影響を強く受けており、アルカノ山へ入る前の記憶を完全に失っている。",
                "trigger": {
                  "type": "Resource",
                  "id": 2000136
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0004",
            "pic2": "T_StringBoard_Main_0048",
            "type": 3
          },
          {
            "id": 120221,
            "name": "「愚者」ジョイ",
            "contents": [
              {
                "id": 12022101,
