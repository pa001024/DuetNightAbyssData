[
  {
    "type": "Ex02_Core",
    "name": "重點",
    "priority": 55,
    "pages": [
      {
        "id": "Ex02_MainStory_1001",
        "name": "富爾維斯",
        "clues": [
          {
            "id": 100101,
            "name": "富爾維斯的行蹤",
            "contents": [
              {
                "id": 10010101,
                "text": "富爾維斯已經來到了弗萊格桑省，當前行動暫不明。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11100001
                }
              },
              {
                "id": 10010102,
                "text": "據「力量」伯納德所說，最近五天沒看到類似富爾維斯的身影出現在阿爾卡諾山。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11100241
                }
              },
              {
                "id": 10010103,
                "text": "「女祭司」艾達也沒見過除我以外的軍團成員，看來阿爾卡諾鎮的鎮民基本都沒見過軍官富爾維斯這個人。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11101617
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0005",
            "pic2": "T_StringBoard_Main_0005",
            "type": 1
          },
          {
            "id": 100102,
            "name": "富爾維斯的行動",
            "contents": [
              {
                "id": 10010201,
                "text": "富爾維斯無法確認法露茜的生死，因此派出密探尋找法露茜的蹤跡，試圖滅口。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11105822
                }
              },
              {
                "id": 10010202,
                "text": "富爾維斯的手下被分為兩隊，駐紮在阿爾卡諾山附近，並沒有深入阿爾卡諾山。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11111019
                }
              },
              {
                "id": 10010203,
                "text": "富爾維斯並沒有失憶，他一直在偽裝成「愚者」喬伊，暗中激化我與樂園鎮的矛盾，只為在雙方兩敗俱傷之時，成功奪取觸媒。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11120338
                }
              },
              {
                "id": 10010204,
                "text": "我看透了富爾維斯的偽裝，早早調換了富爾維斯的通訊器，成功粉碎了他的陰謀。意識到徹底沒有翻盤希望之後，富爾維斯引爆了自己的作戰載具，將阿爾卡諾鎮化為一片火海，想要跟我們同歸於盡。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11120622
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0004",
            "pic2": "T_StringBoard_Main_0006",
            "type": 1
          }
        ],
        "unlock": 11020101
      },
      {
        "id": "Ex02_MainStory_1002",
        "name": "觸媒",
        "clues": [
          {
            "id": 100201,
            "name": "觸媒",
            "contents": [
              {
                "id": 10020101,
                "text": "藉助觸媒，人們可以以一個原型為藍圖，不斷創造出原型的複製品。觸媒極有可能保存在樂園鎮的主人「兔媽媽」手中。只是沒人知道它具體以什麼形式存在。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11100001
                }
              },
              {
                "id": 10020102,
                "text": "觸媒可以複製已經存在的事物，包括人類。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11120305
                }
              },
              {
                "id": 10020103,
                "text": "第二新枝計劃所需要的關鍵觸媒，正是蘊含在艾達血脈之中的複製能力。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11120334
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0004",
            "pic2": "T_StringBoard_Main_0007",
            "type": 1
          }
        ],
        "unlock": 11020101
      },
      {
        "id": "Ex02_MainStory_1003",
        "name": "阿爾卡諾山",
        "clues": [
          {
            "id": 100301,
            "name": "阿爾卡諾鎮的生活",
            "contents": [
              {
                "id": 10030101,
                "text": "阿爾卡諾鎮的每一位居民都有一個獨一無二的名牌，比如艾達的「女祭司」，我的「戰車」，總共21個，這些名牌寓意著名牌持有者都是樂園的一家人。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11101619
                }
              },
              {
                "id": 10030102,
                "text": "樂園鎮有著所有人都必須遵守的規則。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11106524
                }
              },
              {
                "id": 10030103,
                "text": "樂園鎮的生活十分和諧，如果彼此之間出現分歧，他們只會透過遊戲進行調解，而不是一味地爭吵或者訴諸暴力。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11108404
                }
              },
              {
                "id": 10030104,
                "text": "無論是索拉還是卡戎，都能在樂園鎮平等而幸福地生活在一起。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11111057
                }
              },
              {
                "id": 10030105,
                "text": "樂園鎮有一種叫胡桃夾子的玩具，做工精緻，造型可愛。它是鎮民日常生活中的好幫手，據莫甘娜所說，我小時候也跟她學過如何製作這種玩具。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11106804
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0004",
            "pic2": "T_StringBoard_Main_0008",
            "type": 1
          },
          {
            "id": 100302,
            "name": "樂園巡遊",
            "contents": [
              {
                "id": 10030201,
                "text": "樂園鎮每月會舉行一次特別的慶典，其名叫樂園巡遊，兔媽媽會在樂園巡遊之夜駕臨。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11100902
                }
              },
              {
                "id": 10030202,
                "text": "人們會在樂園巡遊時進行一場遊戲，在遊戲投票環節最高得票者將被判出局。\n樂園巡遊本質上是「兔媽媽」對樂園居民進行的一場服從性測試，違反樂園規則的玩家會遭到處決。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11115049
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0004",
            "pic2": "T_StringBoard_Main_0009",
            "type": 1
          },
          {
            "id": 100303,
            "name": "山中異樣",
            "contents": [
              {
                "id": 10030301,
                "text": "不知為何，進山之後我經常會突然地感到頭暈。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11100406
                }
              },
              {
                "id": 10030302,
                "text": "阿爾卡諾鎮原本的居民大多已死於戰爭，如今樂園鎮的居民都是被鎮長和「兔媽媽」脅迫，不得不去扮演死亡居民的外來者。那些違反規則、不好好扮演的人，都會被鎮長處死，埋葬在酣夢池下方的墓園之中。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11117210
                }
              },
              {
                "id": 10030303,
                "text": "阿爾卡諾山的水被切薩雷混入了煉金院的藥劑，這種藥劑本是用來安撫士兵，使他們保持鎮定的存在。但過量使用後則會影響人們的精神，讓人只會服從命令。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11117225
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0004",
            "pic2": "T_StringBoard_Main_0010",
            "type": 1
          },
          {
            "id": 100304,
            "name": "阿爾卡諾鎮的規則·其一",
            "contents": [
              {
                "id": 10030401,
                "text": "第一條 阿爾卡諾山是我們的樂園，我們都是兔媽媽的白兔。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11114213
                }
              },
              {
                "id": 10030402,
                "text": "第二條 全體白兔必須相親相愛，禁止對白兔使用暴力。彼此之間若有矛盾，可以通過遊戲的方式解決。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11114213
                }
              },
              {
                "id": 10030403,
                "text": "第三條 兔子有很多種顏色。白色兔子是我們的朋友，紅色兔子是危險的。如果看到紅色兔子，請立刻報告鎮長。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11114213
                }
              },
              {
                "id": 10030404,
                "text": "第四條 樂園巡遊是阿爾卡諾鎮的盛事，在樂園巡遊慶典上，需要完成一局遊戲。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11114213
                }
              },
              {
                "id": 10030405,
                "text": "第五條 阿爾卡諾山的玩具是我們友好的同伴，可以接受它們的護衛與幫助。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11114213
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0004",
            "pic2": "T_StringBoard_Main_0011",
            "type": 1
          },
          {
            "id": 100305,
            "name": "阿爾卡諾鎮的規則·其二",
            "contents": [
              {
                "id": 10030406,
                "text": "第六條 請所有白兔牢記我們的名牌，它代表著我們的本質。不得違反我們的本質。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11114213
                }
              },
              {
                "id": 10030407,
                "text": "第七條 天上的巨大鐵皮人是樂園的敵人。如果見到巨大鐵皮人，請立即放下手上的一切，前往酣夢池。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11114213
                }
              },
              {
                "id": 10030408,
                "text": "第八條 如果觸犯規則，酣夢池能幫我們找回內心的寧靜。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11114213
                }
              },
              {
                "id": 10030409,
                "text": "第九條 沒有巨大鐵皮人的情況下，未經鎮長允許，禁止靠近酣夢池。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11114213
                }
              },
              {
                "id": 10030410,
                "text": "第十條 為了我們的生活不被外界的紛擾所打破，任何白兔不得輕易離開我們的樂園。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11114213
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0004",
            "pic2": "T_StringBoard_Main_0012",
            "type": 1
          }
        ],
        "unlock": 11020101
      }
    ]
  },
  {
    "type": "Ex02_Region",
    "name": "地區",
    "priority": 45,
    "pages": [
      {
        "id": "Ex02_Region_1101",
        "name": "阿爾卡諾鎮廢墟",
        "clues": [
          {
            "id": 110101,
            "name": "概況",
            "contents": [
              {
                "id": 11010101,
                "text": "四年前被戰爭摧毀的阿爾卡諾鎮，罕有人跡，只剩下幾台設施能勉強運行，也是我與艾達曾經生活過的故鄉。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11101102
                }
              },
              {
                "id": 11010102,
                "text": "四年前，去往前線突襲的軍團飛艇部隊在進攻受挫後緊急迫降在了阿爾卡諾山，倖存士兵接到命令原地進行堅守，儘可能拖住艾利西安傳頌會的地面部隊。最終軍團調來了大規模的空中火力，成功在阿爾卡諾山擋住了傳頌會的進攻，阿爾卡諾鎮也在這場轟炸中被完全摧毀。",
                "trigger": {
                  "type": "Resource",
                  "id": 2000128
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0013",
            "pic2": "T_StringBoard_Main_0014",
            "type": 2
          }
        ],
        "unlock": 11020102
      },
      {
        "id": "Ex02_Region_1102",
        "name": "阿爾卡諾山裂隙",
        "clues": [
          {
            "id": 110201,
            "name": "概況",
            "contents": [
              {
                "id": 11020101,
                "text": "被轟炸的傳頌會士兵撤到了阿爾卡諾山裂隙中，為了延緩軍團士兵的追擊速度，他們一邊撤退一邊沿途布設了大量地雷。",
                "trigger": {
                  "type": "Resource",
                  "id": 2000129
                }
              },
              {
                "id": 11020102,
                "text": "四年前，軍團榴彈攜帶的有毒物質滲進了周圍土地與溪流，形成了面前這灘顏色詭異的湖水，這水極其危險，哪怕是穢獸也無法在其中生存。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11114002
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0015",
            "pic2": "T_StringBoard_Main_0016",
            "type": 2
          }
        ],
        "unlock": 11020104
      },
      {
        "id": "Ex02_Region_1103",
        "name": "阿爾卡諾鎮",
        "clues": [
          {
            "id": 110301,
            "name": "軍團記錄",
            "contents": [
              {
                "id": 11030101,
                "text": "阿爾卡諾鎮位於阿爾卡諾山的山間台地，與阿爾卡諾山同名。起初它的規模很小，隨著鎮民完成了鎮內遊樂園的建設，大量觀光客湧入了阿爾卡諾鎮，小鎮也因此得到了擴建，成為一座繁華的旅遊城鎮。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11100001
                }
              },
              {
                "id": 11030102,
                "text": "\n四年前的戰爭中，阿爾卡諾鎮曾短暫成為邊境軍團的眾多補給點之一。但隨著戰爭愈演愈烈，很多原本安全的城鎮也被捲入了戰火，阿爾卡諾鎮正是這些被戰爭摧毀的城鎮之一。\n根據戰爭倖存者的記錄，阿爾卡諾鎮大部分居民都在當年的戰爭中死亡，阿爾卡諾鎮也就此成為歷史。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11100001
                }
              },
              {
                "id": 11030103,
                "text": "四年前的戰爭在阿爾卡諾山中留下了不可挽回的影響。山間的阿爾卡諾鎮被摧毀，村民全部遇難，大量區域變得不適合人類生存。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11100001
                }
              },
              {
                "id": 11030104,
                "text": "此外，傳頌會士兵撤退時，為了延緩帝國追兵的進軍速度，在山中鋪設了大量地雷。諸多因素疊加在一起，讓帝國在這些年始終沒有對阿爾卡諾山及阿爾卡諾鎮進行收復與重建。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11100001
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0004",
            "pic2": "T_StringBoard_Main_0017",
            "type": 2
          },
          {
            "id": 110302,
            "name": "樂園鎮",
            "contents": [
              {
                "id": 11030201,
                "text": "兔媽媽以一己之力，在飽受戰火摧殘的阿爾卡諾山重建起了阿爾卡諾鎮，並將其更名為樂園鎮。倖存者在樂園鎮中過上了閒適幸福的生活。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11101610
                }
              },
              {
                "id": 11030202,
                "text": "一般情況下，吊橋是樂園鎮唯一的出入口，需要有人在鎮子內側持續拉著開關才能啟動。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11110403
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0018",
            "pic2": "T_StringBoard_Main_0019",
            "type": 2
          },
          {
            "id": 110303,
            "name": "倉庫",
            "contents": [
              {
                "id": 11030301,
                "text": "樂園鎮的倉庫中整齊擺放著各種食物原料、玩具、服裝和裝飾品，它們造型完全一致，連破損都一模一樣，很可能是觸媒的造物。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11108813
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0019",
            "pic2": "T_StringBoard_Main_0021",
            "type": 2
          },
          {
            "id": 110304,
            "name": "酣夢池",
            "contents": [
              {
                "id": 11030401,
                "text": "法露茜獨自調查了酣夢池，那裡什麼人都沒有，看起來更像是一座監牢。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11111047
                }
              },
              {
                "id": 11030402,
                "text": "酣夢池的下方是一座墓園，墓園中埋葬著所有阿爾卡諾鎮的鎮民。其中也包括「我」——維克托的墓。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11117201
                }
              },
              {
                "id": 11030403,
                "text": "在墓穴發現的無法打開的箱子，等塵埃落定之後再來看看吧。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11116801
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0022",
            "pic2": "T_StringBoard_Main_0023",
            "type": 2
          },
          {
            "id": 110305,
            "name": "山林的發現",
            "contents": [
              {
                "id": 11030501,
                "text": "四年前，一架軍團飛艇迫降在此，兩名倖存者在與大部隊會合之前就遭遇了傳頌會的先遣部隊，雙方在林中展開了槍戰。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11112301
                }
              },
              {
                "id": 11030502,
                "text": "我們找到了其中一位士兵倖存者的墓碑，另一位像是軍官的倖存者則下落不明。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11112701
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0069",
            "pic2": "T_StringBoard_Main_0025",
            "type": 2
          }
        ],
        "unlock": 11020101
      }
    ]
  },
  {
    "type": "Ex02_Character",
    "name": "人物",
    "priority": 30,
    "pages": [
      {
        "id": "Ex02_Character_1201",
        "name": "法露茜",
        "clues": [
          {
            "id": 120101,
            "name": "法露茜",
            "contents": [
              {
                "id": 12010101,
                "text": "富爾維斯利用龍莎要塞的爆炸來滅法露茜的口，但法露茜還是在爆炸中活了下來，並一路追到了阿爾卡諾山。可惜的是她手中的錄音設備已在爆炸中損毀，可以用來扳倒富爾維斯的證據又少了一個，至少我要帶著法露茜這個人證回去。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11102821
                }
              },
              {
                "id": 12010102,
                "text": "法露茜自龍莎要塞的爆炸中活下來之後，一心想著殺死富爾維斯完成復仇，從她身上那些還沒痊癒的傷口來看，她在來到阿爾卡諾山的這一路上，已經與富爾維斯的密探進行過不少血腥的廝殺。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11105822
                }
              },
              {
                "id": 12010103,
                "text": "為了尋找那份記錄著龍莎要塞真相的錄音文件，法露茜一個人踏入了火海，下落不明。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11121012
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0004",
            "pic2": "T_StringBoard_Main_0026",
            "type": 3
          }
        ],
        "unlock": 11020104
      },
      {
        "id": "Ex02_Character_1202",
        "name": "阿爾卡諾鎮的鎮民·其一",
        "clues": [
          {
            "id": 120204,
            "name": "「審判」兔媽媽",
            "contents": [
              {
                "id": 12020401,
                "text": "「兔媽媽」是一位神秘而強大的「骸」，也是「第二新枝」計劃的關鍵「觸媒」的持有者。根據阿瓦爾老師的情報，無論發生什麼，哪怕是帶著觸媒與敵人同歸於盡，她也不會將觸媒交出去。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11100001
                }
              },
              {
                "id": 12020402,
                "text": "兔媽媽在阿爾卡諾鎮的地位極高，似乎還是主持阿爾卡諾鎮重建工作的工程師。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11101610
                }
              },
              {
                "id": 12020403,
                "text": "兔媽媽是四年前的戰爭中，阿爾卡諾鎮唯一的倖存者，也就是真正的艾達。她擁有罕見的複製魔法。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11120305
                }
              },
              {
                "id": 12020404,
                "text": "艾達用最後的能力幫我們逃離了正在化為火海的阿爾卡諾鎮廢墟，隨後被鎮長背著走入了火焰，消失在火中，至今下落不明。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11120823
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0031",
            "pic2": "T_StringBoard_Main_0032",
            "type": 3
          },
          {
            "id": 120201,
            "name": "「力量」伯納德",
            "contents": [
              {
                "id": 12020101,
                "text": "阿爾卡諾鎮的獵人，熱情、親切，經常在山中活動，他在前天看到一個陌生的女性身影從林中閃過。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11100241
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0004",
            "pic2": "T_StringBoard_Main_0027",
            "type": 3
          },
          {
            "id": 120202,
            "name": "「女祭司」艾達",
            "contents": [
              {
                "id": 12020201,
                "text": "阿爾卡諾鎮的鎮民之一，看起來性格單純，思維有一些跳躍。據她本人說，她是維克托的童年玩伴。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11100414
                }
              },
              {
                "id": 12020202,
                "text": "法露茜看到了艾達冷漠地殺死了其他鎮民。艾達似乎遠沒有看上去那麼單純無辜。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11105834
                }
              },
              {
                "id": 12020203,
                "text": "艾達喜歡玩遊戲，喜歡遊戲裡多種多樣的身份。她說自己只能一輩子待在深山裡，這是為什麼？",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11103808
                }
              },
              {
                "id": 12020204,
                "text": "艾達對兔媽媽來說是不一樣的。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11115516
                }
              },
              {
                "id": 12020205,
                "text": "在「兔媽媽」的審判中，艾達捨棄了「兔媽媽」賜予的名字「艾達」，為自己取了新的名字「伊薇」。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11118623
                }
              },
              {
                "id": 12020206,
                "text": "實際上是「兔媽媽」，也就是真正的艾達以自己為原型複製出的造物。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11120305
                }
              },
              {
                "id": 12020207,
                "text": "逃離阿爾卡諾山之後，伊薇踏上了獨自一人的旅途，現在，她終於可以親眼看看外面的世界了。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11121420
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0028",
            "pic2": "T_StringBoard_Main_0029",
            "type": 3
          },
          {
            "id": 120203,
            "name": "「戰車」維克托",
            "contents": [
              {
                "id": 12020301,
                "text": "這裡的居民都叫我「戰車」維克托，四年前離開了故鄉阿爾卡諾鎮，加入了軍團。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11100225
                }
              },
              {
                "id": 12020302,
                "text": "小時候，維克托會跟艾達一起捉蟲子，一起在阿爾卡諾鎮遊玩，還會跟伯納德打獵。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11106802
                }
              },
              {
                "id": 12020303,
                "text": "鎮民似乎不能完全確定我現在的長相，我加入軍團之後的變化有這麼大嗎？",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11106537
                }
              },
              {
                "id": 12020304,
                "text": "恍惚中，我看到了一些零碎的記憶片段，似乎是我作為維克托與鎮民們共同生活的回憶。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11108302
                }
              },
              {
                "id": 12020305,
                "text": "我並不是維克托，一切都是阿爾卡諾鎮鎮民的謊言。真正的維克托是阿爾卡諾鎮的居民，已於四年前的戰爭中身故。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11117210
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0004",
            "pic2": "T_StringBoard_Main_0030",
            "type": 3
          },
          {
            "id": 120205,
            "name": "「皇帝」切薩雷",
            "contents": [
              {
                "id": 12020501,
                "text": "阿爾卡諾鎮的鎮長，他給了艾達一種神秘的藥劑，這種藥劑緩解了我與法露茜的傷勢。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11105405
                }
              },
              {
                "id": 12020502,
                "text": "切薩雷給艾達的神秘藥劑正是四年前，煉金院發給高級軍官的強心劑，切薩雷跟軍團有什麼關係？",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11115524
                }
              },
              {
                "id": 12020503,
                "text": "切薩雷正是當年那架迫降飛艇的另一名軍官倖存者，他在阿爾卡諾鎮的廢墟中救下了奄奄一息的艾達。而艾達，對他來說就成了戰爭中唯一的救贖。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11123840
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0004",
            "pic2": "T_StringBoard_Main_0033",
            "type": 3
          },
          {
            "id": 120206,
            "name": "「星星」斯黛拉",
            "contents": [
              {
                "id": 12020601,
                "text": "膽小、愛哭、喜歡擔心的小姑娘。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11106506
                }
              },
              {
                "id": 12020602,
                "text": "斯黛拉心裡藏著一個令她恐懼的秘密，這也是她經常哭泣的理由之一。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11108949
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0004",
            "pic2": "T_StringBoard_Main_0034",
            "type": 3
          },
          {
            "id": 120207,
            "name": "「太陽」艾利歐",
            "contents": [
              {
                "id": 12020701,
                "text": "活潑的小男孩，對我的軍團生活充滿好奇。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11106506
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0004",
            "pic2": "T_StringBoard_Main_0035",
            "type": 3
          }
        ],
        "unlock": 11020101
      },
      {
        "id": "Ex02_Character_1203",
        "name": "阿爾卡諾鎮的鎮民·其二",
        "clues": [
          {
            "id": 120208,
            "name": "「月亮」賽琳娜",
            "contents": [
              {
                "id": 12020801,
                "text": "乖巧懂事的小姑娘，總是與斯黛拉和艾利歐一起行動。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11106506
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0004",
            "pic2": "T_StringBoard_Main_0036",
            "type": 3
          },
          {
            "id": 120209,
            "name": "「女皇」特蕾莎",
            "contents": [
              {
                "id": 12020901,
                "text": "溫柔的婦人，擅長各種家務，廚藝高超。不僅在自己的院子裡種了菜，還在家中養了一些鴿子。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11106506
                }
              },
              {
                "id": 12020902,
                "text": "特蕾莎在「樂園巡遊」的遊戲中出局後，自殺身亡。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11116601
                }
              },
              {
                "id": 12020903,
                "text": "特蕾莎本是一位家庭主婦，追尋失蹤的丈夫弗里德來到了阿爾卡諾山。她早就受不了樂園鎮的生活，終於在近日下定決心，將求救信綁在自己養的鴿子腿上向外求助，可惜她的鴿子被山中的猛禽捕食，直到最後，也沒將求救信送出去。",
                "trigger": {
                  "type": "Resource",
                  "id": 2000134
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0004",
            "pic2": "T_StringBoard_Main_0037",
            "type": 3
          },
          {
            "id": 120210,
            "name": "「魔鬼」亞蒙",
            "contents": [
              {
                "id": 12021001,
                "text": "嚴厲的老人，語氣雖然兇狠，但言語中還是透露著對他人的關心。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11106506
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0004",
            "pic2": "T_StringBoard_Main_0038",
            "type": 3
          },
          {
            "id": 120211,
            "name": "「戀人」維娜",
            "contents": [
              {
                "id": 12021101,
                "text": "嫵媚的少女，好奇我與法露茜的關係。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11106506
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0004",
            "pic2": "T_StringBoard_Main_0039",
            "type": 3
          },
          {
            "id": 120212,
            "name": "「魔術師」莫甘娜",
            "contents": [
              {
                "id": 12021201,
                "text": "擅長手工與機械的年輕女子，心靈手巧。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11106506
                }
              },
              {
                "id": 12021202,
                "text": "在「樂園巡遊」的遊戲中懷疑特蕾莎，致使其出局。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11115003
                }
              },
              {
                "id": 12021203,
                "text": "本名凱薩琳，是民俗學者伍德維爾的學生。她早就擺脫了藥劑的影響，但還是用心扮演著「魔術師」莫甘娜，只為尋得一個最穩妥，最安全的逃跑時機。此前將懷疑方向引向特蕾莎，應是出於保護老師的緣故。為了自己與老師的安全，她冷靜到甚至有些冷血。",
                "trigger": {
                  "type": "Resource",
                  "id": 2000135
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0004",
            "pic2": "T_StringBoard_Main_0040",
            "type": 3
          },
          {
            "id": 120213,
            "name": "「教皇」桑克圖斯",
            "contents": [
              {
                "id": 12021301,
                "text": "虔誠的中年男子，將兔媽媽視作神明。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11106506
                }
              },
              {
                "id": 12021302,
                "text": "桑克圖斯在外面受盡了索拉之民的壓迫，最終在樂園獲得了唯一的容身之處，因此對兔媽媽無比忠誠，甚至願意為了她付出生命。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11118913
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0004",
            "pic2": "T_StringBoard_Main_0041",
            "type": 3
          },
          {
            "id": 120214,
            "name": "「命運之輪」卡爾瑪",
            "contents": [
              {
                "id": 12021401,
                "text": "神神叨叨的青年，總是說著一些讓人聽不懂的話。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11106506
                }
              },
              {
                "id": 12021402,
                "text": "卡爾瑪本是一位一無所有的流浪漢，他也早就受夠了「命運之輪」高深莫測、神神秘秘的說話方式。逃離兔媽媽的掌控後，他的情緒得到了徹底的爆發。",
                "trigger": {
                  "type": "Resource",
                  "id": 2000138
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0004",
            "pic2": "T_StringBoard_Main_0042",
            "type": 3
          }
        ],
        "unlock": 11020302
      },
      {
        "id": "Ex02_Character_1204",
        "name": "阿爾卡諾鎮的鎮民·其三",
        "clues": [
          {
            "id": 120215,
            "name": "「正義」加斯圖斯",
            "contents": [
              {
                "id": 12021501,
                "text": "嚴厲的中年男子，反覆強調著樂園鎮的規則。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11106506
                }
              },
              {
                "id": 12021502,
                "text": "加斯圖斯曾是一位受僱於人的殺手，在外界失去了立足之處，最終在樂園重獲新生。無論如何，他都不會背叛兔媽媽。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11118917
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0004",
            "pic2": "T_StringBoard_Main_0043",
            "type": 3
          },
          {
            "id": 120216,
            "name": "「倒吊人」伊薩克",
            "contents": [
              {
                "id": 12021601,
                "text": "熱情的老人，並不負責阿爾卡諾鎮的什麼事物，看起來總是十分悠閒。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11106506
                }
              },
              {
                "id": 12021602,
                "text": "本名伍德維爾，是伊瑟爾的一位民俗學者。他帶著自己的學生凱薩琳來到阿爾卡諾山進行考察，卻被兔媽媽囚禁，只得在樂園鎮中扮演「倒吊人」。",
                "trigger": {
                  "type": "Resource",
                  "id": 2000135
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0004",
            "pic2": "T_StringBoard_Main_0044",
            "type": 3
          },
          {
            "id": 120217,
            "name": "「塔」安比修",
            "contents": [
              {
                "id": 12021701,
                "text": "看上去有些呆傻的青年，衣服上還帶有神棄者同盟的標誌，不知道他與神棄者同盟是什麼關係。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11106506
                }
              },
              {
                "id": 12021702,
                "text": "經過審問，軍團初步判斷他確實是神棄者同盟的成員之一，只是由於切薩雷的藥物而徹底失去了記憶。",
                "trigger": {
                  "type": "Resource",
                  "id": 2000137
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0004",
            "pic2": "T_StringBoard_Main_0045",
            "type": 3
          },
          {
            "id": 120218,
            "name": "「隱士」塔西",
            "contents": [
              {
                "id": 12021801,
                "text": "沉默的老婦人，很難溝通。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11106506
                }
              },
              {
                "id": 12021802,
                "text": "塔西原名珍妮，幾年前因為與他人鬥氣打賭，而來到了阿爾卡諾山。",
                "trigger": {
                  "type": "Resource",
                  "id": 2000139
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0004",
            "pic2": "T_StringBoard_Main_0046",
            "type": 3
          },
          {
            "id": 120219,
            "name": "「死神」菲尼斯",
            "contents": [
              {
                "id": 12021901,
                "text": "我只聽到過這個名字，並未在阿爾卡諾鎮見過他。想來他就是法露茜看到的，被艾達無情殺死的鎮民。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11121420
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0004",
            "pic2": "T_StringBoard_Main_0047",
            "type": 3
          },
          {
            "id": 120220,
            "name": "「節制」門蘇拉",
            "contents": [
              {
                "id": 12022001,
                "text": "一絲不苟的中年婦女，有些強迫行為。",
                "trigger": {
                  "type": "Dialogue",
                  "id": 11106506
                }
              },
              {
                "id": 12022002,
                "text": "經過審問，她受切薩雷的藥物影響十分嚴重，已經完全失去了進入阿爾卡諾山之前的記憶。",
                "trigger": {
                  "type": "Resource",
                  "id": 2000136
                }
              }
            ],
            "pic1": "T_StringBoard_Main_0004",
            "pic2": "T_StringBoard_Main_0048",
            "type": 3
