[
  {
    "id": 1001,
    "name": "Paniemon",
    "rewardId": 3011,
    "groups": [
      {
        "id": 7000054,
        "srId": 100101,
        "pos": [
          3306,
          5100
        ],
        "dialogues": [
          {
            "id": 72000202,
            "content": "Eeya~ You found me.",
            "npc": 820000,
            "next": 72000203
          },
          {
            "id": 72000203,
            "content": "The trees hold me so warmly... but I can't stay curled up here forever.",
            "npc": 820000,
            "next": 72000204
          }
        ]
      },
      {
        "id": 7000055,
        "srId": 100101,
        "pos": [
          6161,
          -1757
        ],
        "dialogues": [
          {
            "id": 72000302,
            "content": "Someone lit the lamp.",
            "npc": 820000,
            "next": 72000303
          },
          {
            "id": 72000303,
            "content": "Do you think... the sun might be someone's lantern too?",
            "npc": 820000,
            "next": 72000304
          }
        ]
      },
      {
        "id": 7000058,
        "srId": 100101,
        "pos": [
          3920,
          470
        ],
        "dialogues": [
          {
            "id": 72003902,
            "content": "The birds that move, the birds that don't, and the people who don't move are all still here.",
            "npc": 820000,
            "next": 72003903
          },
          {
            "id": 72003903,
            "content": "But the people who moved are all gone... Will they ever come back?",
            "npc": 820000,
            "next": 72003904
          }
        ]
      },
      {
        "id": 7001039,
        "srId": 100102,
        "pos": [
          22429,
          -5823
        ],
        "dialogues": [
          {
            "id": 72000402,
            "content": "If I drift like the wind... do you think the wind might befriend me?",
            "npc": 820000,
            "next": 72000403
          },
          {
            "id": 72000403,
            "content": "Would you like to be its friend, too?",
            "npc": 820000,
            "next": 72000404
          }
        ]
      },
      {
        "id": 7001040,
        "srId": 100102,
        "pos": [
          27339,
          5982
        ],
        "dialogues": [
          {
            "id": 72000502,
            "content": "Thank you, leafy human... I was stuck in this cold, round bucket for ages...",
            "npc": 820000,
            "next": 72000503
          },
          {
            "id": 72000503,
            "content": "Hmm, the grass is gone... But thank you anyway, snowy human.",
            "npc": 820000,
            "next": 72000504
          }
        ]
      }
    ]
  },
  {
    "id": 1011,
    "name": "Paniemon",
    "rewardId": 3011,
    "groups": [
      {
        "id": 7010091,
        "srId": 101101,
        "pos": [
          -6800,
          14207
        ],
        "dialogues": [
          {
            "id": 72001102,
            "content": "I thought this box was a Bro Boxie. I spent forever trying to talk him into moving.",
            "npc": 820000,
            "next": 72001103
          },
          {
            "id": 72001103,
            "content": "Turns out he wasn't. Maybe I should've given him a teeny kick...",
            "npc": 820000,
            "next": 72001104
          }
        ]
      },
      {
        "id": 7010092,
        "srId": 101101,
        "pos": [
          2622,
          15568
        ],
        "dialogues": [
          {
            "id": 72001202,
            "content": "This tree looks tired... It's just lying down for a nap.",
            "npc": 820000,
            "next": 72001203
          },
          {
            "id": 72001203,
            "content": "Do you think the snow on the ground is tired too? Maybe it just wanted a little rest.",
            "npc": 820000,
            "next": 72001204
          }
        ]
      },
      {
        "id": 7010093,
        "srId": 101101,
        "pos": [
          -5764,
          3585
        ],
        "dialogues": [
          {
            "id": 72001302,
            "content": "It's nice and warm here. You can sit with me if you like.",
            "npc": 820000,
            "next": 72001303
          },
          {
            "id": 72001303,
            "content": "Just don't stay too long — my other friends might get chilly.",
            "npc": 820000,
            "next": 72001304
          }
        ]
      },
      {
        "id": 7010094,
        "srId": 101101,
        "pos": [
          -1875,
          2287
        ],
        "dialogues": [
          {
            "id": 72001402,
            "content": "This is a dead end... mm...",
            "npc": 820000,
            "next": 72001403
          },
          {
            "id": 72001403,
            "content": "Or maybe what I meant was — I want to be alone for a while. Would you like to be alone with me?",
            "npc": 820000,
            "next": 72001404
          },
          {
            "id": 72001404,
            "content": "But... does that still count as being alone?",
            "npc": 820000,
            "next": 72001405
          }
        ]
      },
      {
        "id": 7010095,
        "srId": 101101,
        "pos": [
          -3618,
          -10058
        ],
        "dialogues": [
          {
            "id": 72001502,
            "content": "These houses look so tired. Their skin's all spotty and peeling...",
            "npc": 820000,
            "next": 72001503
          },
          {
            "id": 72001503,
            "content": "I hope they get better soon.",
            "npc": 820000,
            "next": 72001504
          }
        ]
      },
      {
        "id": 7010096,
        "srId": 101101,
        "pos": [
          -2836,
          -1235
        ],
        "dialogues": [
          {
            "id": 72001602,
            "content": "This mountain is so tall! So bright! Look at me — on the top! I'm amazing!",
            "npc": 820000,
            "next": 72001603
          },
          {
            "id": 72001603,
            "content": "Eeya? This isn't a mountain? Uh-uh!",
            "npc": 820000,
            "next": 72001604
          },
          {
            "id": 72001604,
            "content": "It's tall and pointy... totally a mountain!",
            "npc": 820000,
            "next": 72001605
          }
        ]
      },
      {
        "id": 7010100,
        "srId": 101101,
        "pos": [
          -11678,
          279
        ],
        "dialogues": [
          {
            "id": 72001002,
            "content": "The wall says it only keeps out what it wants to keep out.",
            "npc": 820000,
            "next": 72001003
          },
          {
            "id": 72001003,
            "content": "But if it likes you... it lets you through.",
            "npc": 820000,
            "next": 72001004
          }
        ]
      },
      {
        "id": 7011065,
        "srId": 101103,
        "pos": [
          -25486,
          -3701
        ],
        "dialogues": [
          {
            "id": 72002202,
            "content": "I want to race the cars.",
            "npc": 820000,
            "next": 72002203
          },
          {
            "id": 72002203,
            "content": "But what if they go too fast and slip? I'd feel bad for them...",
            "npc": 820000,
            "next": 72002204
          }
        ]
      },
      {
        "id": 7011066,
        "srId": 101103,
        "pos": [
          -31822,
          -12454
        ],
        "dialogues": [
          {
            "id": 72001702,
            "content": "If you can see the path right under your feet... Would you still be less scared of the Filthoids?",
            "npc": 820000,
            "next": 72001703
          },
          {
            "id": 72001703,
            "content": "Ta-da~! Now it's all nice and bright.",
            "npc": 820000,
            "next": 72001704
          }
        ]
      },
      {
        "id": 7011068,
        "srId": 101103,
        "pos": [
          -29450,
          -9128
        ],
        "dialogues": [
          {
            "id": 72001902,
            "content": "Hmph! Everyone's here — except that one who ran away!",
            "npc": 820000,
            "next": 72001903
          },
          {
            "id": 72001903,
            "content": "Alright, now, let's start the Boxie Party!",
            "npc": 820000,
            "next": 72001904
          }
        ]
      },
      {
        "id": 7017050,
        "srId": 101103,
        "pos": [
          -12528,
          -1850
        ],
        "dialogues": [
          {
            "id": 72002402,
            "content": "Do you think... someone super strong — like a god, maybe — could pick up the whole Lamenting Lake and eat it like candy?",
            "npc": 820000,
            "next": 72002403
          },
          {
            "id": 72002403,
            "content": "I wonder what it tastes like. It's blue, so... maybe it tastes like the sky?",
            "npc": 820000,
            "next": 72002404
          }
        ]
      },
      {
        "id": 7017070,
        "srId": 101103,
        "pos": [
          -33946,
          11686
        ],
        "dialogues": [
          {
            "id": 72002602,
            "content": "Mm~ Thank you for building a cabin for me.",
            "npc": 820000,
            "next": 72002603
          },
          {
            "id": 72002603,
            "content": "If you ever grow as tall as me, you can move in too — and we'll be neighbours.",
            "npc": 820000,
            "next": 72002604
          }
        ]
      },
      {
        "id": 7017074,
        "srId": 101103,
        "pos": [
          -45413,
          -7469
        ],
        "dialogues": [
          {
            "id": 72001802,
            "content": "I smell many people here... But I don't see them.",
            "npc": 820000,
            "next": 72001803
          },
          {
            "id": 72001803,
            "content": "Where did they go?",
            "npc": 820000,
            "next": 72001804
          }
        ]
      },
      {
        "id": 7060003,
        "srId": 101108,
        "pos": [
          37795,
          13388
        ],
        "dialogues": [
          {
            "id": 72002702,
            "content": "Where are you off to?",
            "npc": 820000,
            "next": 72002703
          },
          {
            "id": 72002703,
            "content": "If you see that human who looks like a piece of broken glass... try to be her friend, okay?",
            "npc": 820000,
            "next": 72002704
          }
        ]
      }
    ]
  },
  {
    "id": 1013,
    "name": "Paniemon",
    "rewardId": 3011,
    "groups": [
      {
        "id": 7012018,
        "srId": 101301,
        "pos": [
          10360,
          4110
        ],
        "dialogues": [
          {
            "id": 72004002,
            "content": "Every light that goes out is someone who didn't make it home...",
            "npc": 820000,
            "next": 72004003
          },
          {
            "id": 72004003,
            "content": "Then every light that turns on must be someone who found their way back, right?",
            "npc": 820000,
            "next": 72004004
          }
        ]
      },
      {
        "id": 7018008,
        "srId": 101304,
        "pos": [
          17200,
          34020
        ],
        "dialogues": [
          {
            "id": 72004202,
            "content": "What's the point of stacking boxes so high?",
            "npc": 820000,
            "next": 72004203
          },
          {
            "id": 72004203,
            "content": "You should just let me have them for my house!",
            "npc": 820000,
            "next": 72004204
          }
        ]
      }
    ]
  },
  {
    "id": 1017,
    "name": "Paniemon",
    "rewardId": 3011,
    "groups": [
      {
        "id": 7020075,
        "srId": 101701,
        "pos": [
          -6075,
          5070
        ],
        "dialogues": [
          {
            "id": 72004302,
            "content": "Floaty float, I'm a free little ducky!",
            "npc": 820000,
            "next": 72004303
          },
          {
            "id": 72004303,
            "content": "Eek! Why did you drain my swimming pool?",
            "npc": 820000,
            "next": 72004304
          }
        ]
      },
      {
        "id": 7021028,
        "srId": 101701,
        "pos": [
          -22090,
          5830
        ],
        "dialogues": [
          {
            "id": 72004602,
            "content": "Ta-daa! Congrats on finding my secret base!",
            "npc": 820000,
            "next": 72004603
          },
          {
            "id": 72004603,
            "content": "The vines, the water plants, the pond, and me... we're our own little ecosystem!",
            "npc": 820000,
            "next": 72004604
          }
        ]
      },
      {
        "id": 7021030,
        "srId": 101702,
        "pos": [
          -35270,
          -16890
        ],
        "dialogues": [
          {
            "id": 72004502,
            "content": "Dum-dum, dum-dum-dum!",
            "npc": 820000,
            "next": 72004503
          },
          {
            "id": 72004503,
            "content": "I'm learning to play this pipe organ!",
            "npc": 820000,
            "next": 72004504
          }
        ]
      },
      {
        "id": 7022013,
        "srId": 101703,
        "pos": [
          -11660,
          -5460
        ],
        "dialogues": [
          {
            "id": 72002902,
            "content": "Eek! Please don't take that treasure chest!",
            "npc": 820000,
            "next": 72002903
          },
          {
            "id": 72002903,
            "content": "My home's been taken over by nasty rats! I was gonna use these coins to hire a brave little cat to chase them away.",
            "npc": 820000,
            "next": 72002904
          },
          {
            "id": 72003002,
            "content": "Whoa, you're amazing! Whoosh—swish—BAM! You wiped out all the rats!",
            "npc": 820000,
            "next": 72003003
          },
          {
            "id": 72003003,
            "content": "Thank you, you can have this chest!",
            "npc": 820000,
            "next": 72003004
          }
        ]
      }
    ]
  },
  {
    "id": 1021,
    "name": "Paniemon",
    "rewardId": 3011,
    "groups": [
      {
        "id": 7030055,
        "srId": 102101,
        "pos": [
          -4267,
          -47051
        ],
        "dialogues": [
          {
            "id": 72000602,
            "content": "Spin, spin, spin... oh no, I'm dizzy.",
            "npc": 820000,
            "next": 72000603
          },
          {
            "id": 72000603,
            "content": "This thing's dangerous! It's full of Phoxichor, but it just keeps turning and turning. Is it a trap?",
            "npc": 820000,
            "next": 72000604
          }
        ]
      },
      {
        "id": 7030071,
        "srId": 102101,
        "pos": [
          -6281,
          -3629
        ],
        "dialogues": [
          {
            "id": 72000702,
            "content": "Some run, some chase...",
            "npc": 820000,
            "next": 72000703
          },
          {
            "id": 72000703,
            "content": "Do humans like playing hide-and-seek too? But none of you look like you're having fun...",
            "npc": 820000,
            "next": 72000704
          }
        ]
      },
      {
        "id": 7030072,
        "srId": 102101,
        "pos": [
          11421,
          -48647
        ],
        "dialogues": [
          {
            "id": 72003102,
            "content": "What are you looking for?",
            "npc": 820000,
            "next": 72003103
          },
          {
            "id": 72003103,
            "content": "If you're not looking for me, I can help.",
            "npc": 820000,
            "next": 72003104
          }
        ]
      },
      {
        "id": 7030074,
        "srId": 102101,
        "pos": [
          -2443,
          -42175
        ],
        "dialogues": [
          {
            "id": 72003302,
            "content": "So many people came, and so many left.",
            "npc": 820000,
            "next": 72003303
          },
          {
            "id": 72003303,
            "content": "So many scents lingering... I can't remember them all. Can you?",
            "npc": 820000,
            "next": 72003304
          }
        ]
      },
      {
        "id": 7030081,
        "srId": 102101,
        "pos": [
          11012,
          -31063
        ],
        "dialogues": [
          {
            "id": 72000802,
            "content": "Three soldiers went to the zoo... Two ran off to chase the sun...",
            "npc": 820000,
            "next": 72000803
          },
          {
            "id": 72000803,
            "content": "And one... will be just fine.",
            "npc": 820000,
            "next": 72000804
          }
        ]
      },
      {
        "id": 7031051,
        "srId": 102102,
        "pos": [
          -5805,
          -20124
        ],
        "dialogues": [
          {
            "id": 72003602,
            "content": "Mmm... this place smells a bit like the outside world. It smells happy, and awesome!",
            "npc": 820000,
            "next": 72003603
          },
          {
            "id": 72003603,
            "content": "Not like those other places full of the smell of yelling and fighting.",
            "npc": 820000,
            "next": 72003604
          }
        ]
      },
      {
        "id": 7031052,
        "srId": 102102,
        "pos": [
          -17744,
          -8834
        ],
        "dialogues": [
          {
            "id": 72003502,
            "content": "Owie...! That steam hit me.",
            "npc": 820000,
            "next": 72003503
          },
          {
            "id": 72003503,
            "content": "He's mean. I don't like him. And you shouldn't be his friend, either!",
            "npc": 820000,
            "next": 72003504
          }
        ]
      },
      {
        "id": 7031063,
        "srId": 102102,
        "pos": [
          -10601,
          3126
        ],
        "dialogues": [
          {
            "id": 72000902,
            "content": "There. Now no one's sitting the wrong way round.",
            "npc": 820000,
            "next": 72000903
          },
          {
            "id": 72000903,
            "content": "No more bumped knees either — even if your legs are super long.",
            "npc": 820000,
            "next": 72000904
          }
        ]
      }
    ]
  },
  {
    "id": 1060,
    "name": "Paniemon",
    "rewardId": 3011,
    "groups": [
      {
        "id": 7090063,
        "srId": 106001,
        "pos": [
          -10873,
          -4790
        ],
        "dialogues": [
          {
            "id": 72004702,
            "content": "Glass is see-through, so nobody pays it any mind.",
            "npc": 820000,
            "next": 72004703
          },
          {
            "id": 72004703,
            "content": "Unless its face gets dirty — then someone comes to wash it.",
            "npc": 820000,
            "next": 72004704
          },
          {
            "id": 72004704,
            "content": "So, did you come to me because I got something dirty?",
            "npc": 820000,
            "next": 72004705
          }
        ]
      },
      {
        "id": 7090064,
        "srId": 106001,
        "pos": [
          -3045,
          4865
        ],
        "dialogues": [
          {
            "id": 72004802,
            "content": "Messy, messy. Dirty, dirty.",
            "npc": 820000,
            "next": 72004803
          },
          {
            "id": 72004803,
            "content": "It's a mess here, and everyone's busy. So I stay here, waiting to see when someone will notice me.",
            "npc": 820000,
            "next": 72004804
          },
          {
            "id": 72004804,
            "content": "How long has it been? Hmm... can't see the sun in here, so I don't really know.",
            "npc": 820000,
            "next": 72004805
          },
          {
            "id": 72004805,
            "content": "But I've been counting — people have come and gone over nine thousand times now.",
            "npc": 820000,
            "next": 72004806
          }
        ]
      },
      {
        "id": 7090065,
        "srId": 106001,
        "pos": [
          -7976,
          10
        ],
        "dialogues": [
          {
            "id": 72004902,
            "content": "This bronze flower is broken! Flowers have stamens!",
            "npc": 820000,
            "next": 72004903
          },
          {
            "id": 72004903,
            "content": "A flower without a stamen is like a person without a heart.",
            "npc": 820000,
            "next": 72004904
          },
          {
            "id": 72004904,
            "content": "So I'm here pretending to be the stamen. Hello, yes, I'm the stamen.",
            "npc": 820000,
            "next": 72004905
          }
        ]
      },
      {
        "id": 7090070,
        "srId": 106001,
        "pos": [
          -7982,
          -655
        ],
        "dialogues": [
          {
            "id": 72005402,
            "content": "Humans weave flowers into rings and put them on people they like.",
            "npc": 820000,
            "next": 72005403
          },
          {
            "id": 72005403,
            "content": "I like this place. So I drew a circle with my footprints and put it on here!",
            "npc": 820000,
            "next": 72005404
          }
        ]
      },
      {
        "id": 7090071,
        "srId": 106001,
        "pos": [
          -6704,
          7194
        ],
        "dialogues": [
          {
            "id": 72005502,
            "content": "This place is dangerous! It's as tall as dozens of me stacked up.",
            "npc": 820000,
            "next": 72005503
          },
          {
            "id": 72005503,
            "content": "So I left a mark right in the middle of every board.",
            "npc": 820000,
            "next": 72005504
          },
          {
            "id": 72005504,
            "content": "Follow the marks, and you won't have to worry about falling down.",
            "npc": 820000,
            "next": 72005505
          }
        ]
      },
      {
        "id": 7090075,
        "srId": 106001,
        "pos": [
          -31907,
          19386
        ],
        "dialogues": [
          {
            "id": 72005902,
            "content": "Such a neat forest!",
            "npc": 820000,
            "next": 72005903
          },
          {
            "id": 72005903,
            "content": "Did these trees all come from the same mother? Why do they all look the same?",
            "npc": 820000,
            "next": 72005904
          },
          {
            "id": 72005904,
            "content": "Huh? Man-made? Can people give birth to steel frames? I've never heard of that. You better not be tricking me.",
            "npc": 820000,
            "next": 72005905
          }
        ]
      }
    ]
  },
  {
    "id": 1063,
