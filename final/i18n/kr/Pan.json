[
  {
    "id": 1001,
    "name": "마령 판신",
    "rewardId": 3011,
    "dialogues": [
      {
        "id": 72003802,
        "content": "음, 이 세 송이 꽃으로 뭘 하려고 그래?",
        "npc": 820000,
        "next": 72003803
      },
      {
        "id": 72003803,
        "content": "하나는 태양에게, 하나는 달에게, 하나는 별에게 주려고?",
        "npc": 820000,
        "next": 72003804
      },
      {
        "id": 72003902,
        "content": "움직이는 새, 움직이지 않는 새, 움직이지 않는 사람은 다 여기에 있어.",
        "npc": 820000,
        "next": 72003903
      },
      {
        "id": 72003903,
        "content": "하지만 움직일 줄 아는 사람은 전부 떠나 버렸어. 그들이 돌아올까?",
        "npc": 820000,
        "next": 72003904
      },
      {
        "id": 72000002,
        "content": "兄弟，你好",
        "npc": 820000,
        "next": 72000003
      },
      {
        "id": 72000003,
        "content": "很高兴见到你",
        "npc": 820000,
        "next": 72000004
      },
      {
        "id": 72000202,
        "content": "야하, 날 찾아 냈네?",
        "npc": 820000,
        "next": 72000203
      },
      {
        "id": 72000203,
        "content": "나무의 품 안은 따뜻하지만, 계속 여기 있을 수는 없지.",
        "npc": 820000,
        "next": 72000204
      },
      {
        "id": 72000302,
        "content": "누군가가 등불을 밝혔네.",
        "npc": 820000,
        "next": 72000303
      },
      {
        "id": 72000303,
        "content": "태양도 누군가가 밝힌 등불일까?",
        "npc": 820000,
        "next": 72000304
      },
      {
        "id": 72000402,
        "content": "바람처럼 떠다니면 바람과 친구가 될 수 있을까.",
        "npc": 820000,
        "next": 72000403
      },
      {
        "id": 72000403,
        "content": "너도 바람의 친구가 되고 싶니?",
        "npc": 820000,
        "next": 72000404
      },
      {
        "id": 72000502,
        "content": "고마워, 풀숲 같은 인간... 난 이 둥글고 차가운 통에 오랫동안 갇혀 있었어...",
        "npc": 820000,
        "next": 72000503
      },
      {
        "id": 72000503,
        "content": "음, 풀숲은 사라졌지만, 그래도 고마워, 눈 같은 인간.",
        "npc": 820000,
        "next": 72000504
      }
    ],
